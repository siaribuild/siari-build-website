# Fingerprinted build assets never change — cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — cache hard.
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML: let Cloudflare revalidate so publishes (after rebuild) go live promptly.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Security headers (addresses the HSTS / framing Best-Practices findings).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

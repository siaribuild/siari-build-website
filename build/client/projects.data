to combine modern architecture with practical family living. At approximately 300sqm, this residence showcases clean architectural lines, quality finishes and thoughtfully designed living spaces, delivering a home that is both functional and timeless.","afdadf349b69",[691],[],{"_93":583,"_95":109,"_110":692,"_112":241},[],"4b879d29-b186-4f79-b95a-c8860c446343",[703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725],{"_59":33,"_60":32,"_61":699,"_63":700,"_65":701,"_67":702,"_69":251},"https://cdn.sanity.io/images/f0yvhrzy/production/448e824e9820919d01a4a66894b49959f736b3a3-1427x1102.jpg","bentleigh-east-development","Bentleigh East Development","Private Development","12 months","Bentleigh East, VIC","615 sqm",{"_93":853,"_95":96,"_97":854,"_103":855,"_105":238},{"_93":847,"_95":96,"_97":848,"_103":849,"_105":106},{"_93":841,"_95":96,"_97":842,"_103":843,"_105":106},{"_93":836,"_95":96,"_97":837,"_103":838,"_105":183},{"_93":830,"_95":96,"_97":831,"_103":832,"_105":106},{"_93":824,"_95":96,"_97":825,"_103":826,"_105":106},{"_93":819,"_95":96,"_97":820,"_103":821,"_105":183},{"_93":813,"_95":96,"_97":814,"_103":815,"_105":106},{"_93":807,"_95":96,"_97":808,"_103":809,"_105":106},{"_93":802,"_95":96,"_97":803,"_103":804,"_105":183},{"_93":796,"_95":96,"_97":797,"_99":100,"_101":102,"_103":798,"_105":106},{"_93":790,"_95":96,"_97":791,"_99":100,"_101":102,"_103":792,"_105":106},{"_93":784,"_95":96,"_97":785,"_99":100,"_101":102,"_103":786,"_105":106},{"_93":778,"_95":96,"_97":779,"_99":100,"_101":102,"_103":780,"_105":106},{"_93":772,"_95":96,"_97":773,"_99":100,"_101":102,"_103":774,"_105":106},{"_93":766,"_95":96,"_97":767,"_99":100,"_101":102,"_103":768,"_105":106},{"_93":761,"_95":96,"_97":762,"_99":100,"_101":102,"_103":763,"_105":106},{"_93":755,"_95":96,"_97":756,"_99":100,"_101":102,"_103":757,"_105":106},{"_93":749,"_95":96,"_97":750,"_99":100,"_101":102,"_103":751,"_105":106},{"_93":744,"_95":96,"_97":745,"_99":100,"_101":
[135],[],{"_93":108,"_95":109,"_110":136,"_112":137},[],"Premium natural stone finishes","8e37c2302111",[141],[],{"_93":108,"_95":109,"_110":142,"_112":143},[],"Custom-designed joinery throughout","46f2efb85ac5",[147],[],{"_93":108,"_95":109,"_110":148,"_112":149},[],"Designer kitchen with premium appliances","df89c3404ecf",[153],[],{"_93":108,"_95":109,"_110":154,"_112":155},[],"Open-plan kitchen, living and dining","4a3267b6798d",[159],[],{"_93":108,"_95":109,"_110":160,"_112":161},[],"Premium architectural façade","7f860b5a529a",[165],[],{"_93":108,"_95":109,"_110":166,"_112":167},[],"Architecturally designed contemporary home","5ac407ef52f1",[171],[],{"_93":108,"_95":109,"_110":172,"_112":173},[],"Built on a 300sqm inner-city allotment","7a4121cab82c",[177],[],{"_93":108,"_95":109,"_110":178,"_112":179},[],"Approximately 335sqm (36 Squares) custom residence","1ca9cd236cca",[184],[],"h3",{"_93":108,"_95":109,"_110":185,"_112":186},[],"Key Features","8ba20743643c",[190],[],{"_93":108,"_95":109,"_110":191,"_112":192},[],"Every aspect of the home has been carefully considered to deliver a residence that is both functional and visually striking, demonstrating our commitment to quality and innovation.","9461264a2d82",[196],[],{"_93":108,"_95":109,"_110":197,"_112":198},[],"Siari Build managed the project from planning through to construction, coordinating every stage to ensure a seamless building process. By combining intelligent design, efficient site management and exceptional craftsmanship, the project maximises every square metre of the allotment while creating spacious, light-filled living areas and a premium architectural finish.","069ec55841ed",[202],[],{"_93":108,"_95":109,"_110":203,"_112":204},[],"Our Solution","fee527c28b83",[208],[],{"_93":108,"_95":109,"_110":209,"_112":210},[],"Managing planning approvals, demolition, engineering, protection works and construction sequencing while maintaining safety, quality and efficiency required strong project management and close coordination with consultants, authorities and trades.","81d15e42d8b7",[214],[],{"_93":108,"_95":109,"_110":215,"_112":216},[],"Constructing a luxury custom home within Melbourne’s inner-city environment presented a unique set of challenges. The compact 300sqm site, close proximity to neighbouring properties, restricted access and extensive council requirements demanded meticulous planning before construction could commence.","9ae5de5ebb23",[220],[],{"_93":108,"_95":109,"_110":221,"_112":222},[],"The Challenge","9312f000e9b5",[226],[],{"_93":108,"_95":109,"_110":227,"_112":228},[],"Located in one of Melbourne’s most established suburbs, this project reflects Siari Build’s ability to deliver high-quality custom homes on challenging urban sites where careful planning, precision and attention to detail are essential.","48b27a3a1a57",[232],[],{"_93":108,"_95":109,"_110":233,"_112":234},[],"The Collingwood Residence is a bespoke 36-square architecturally designed custom home currently under construction on a 300sqm inner-city allotment. Designed to maximise space, natural light and modern family living, the residence combines contemporary architecture with premium finishes and exceptional craftsmanship.","ce610f70c49f",[239],[],"h2",{"_93":108,"_95":109,"_110":240,"_112":241},[],"Overview","2c2eddfc-3a13-473d-bb98-8dbd1981f8e1",[252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271],{"_59":27,"_60":25,"_61":62,"_63":248,"_65":249,"_67":250,"_69":251},"https://cdn.sanity.io/images/f0yvhrzy/production/8c2c7fc9112ae303befd56723154e4194cbc03ff-1024x1024.jpg","reservoir-granny-flat","Reservoir Granny Flat","4 months","Reservoir, VIC","60 sqm","2023",{"_93":383,"_95":96,"_97":384,"_103":385,"_105":238},{"_93":377,"_95":96,"_97":378,"_103":379,"_105":106},{"_93":371,"_95":96,"_97":372,"_103":373,"_105":106},{"_93":366,"_95":96,"_97":367,"_103":368,"_105":106},{"_93":360,"_95":96,"_97":361,"_103":362,"_105":106},{"_93":355,"_95":96,"_97":356,"_103":357,"_105":183},{"_93":349,"_95":96,"_97":350,"_103":351,"_105":106},{"_93":344,"_95":96,"_97":345,"_103":346,"_105":183},{"_93":338,"_95":96,"_97":339,"_99":100,"_101":102,"_103":340,"_105":106},{"_93":332,"_95":96,"_97":333,"_99":100,"_101":102,"_103":334,"_105":106},{"_93":326,"_95":96,"_97":327,"_99":100,"_101":102,"_103":328,"_105":106},{"_93":320,"_95":96,"_97":321,"_99":100,"_101":102,"_103":322,"_105":106},{"_93":314,"_95":96,"_97":315,"_99":100,"_101":102,"_103":316,"_105":106},{"_93":308,"_95":96,"_97":309,"_99":100,"_101":102,"_103":310,"_105":106},{"_93":302,"_95":96,"_97":303,"_99":100,"_101":102,"_103":304,"_105":106},{"_93":297,"_95":96,"_97":298,"_99":100,"_101":102,"_103":299,"_105":106},{"_93":291,"_95":96,"_97":292,"_99":100,"_101":102,"_103":293,"_105":106},{"_93":285,"_95":96,"_97":286,"_99":100,"_101":102,"_103":287,"_105":106},{"_93":279,"_95":96,"_97":280,"_99":100,"_101":102,"_103":281,"_105":106},{"_93":272,"_95":96,"_97":273,"_99":100,"_101":102,"_103":274,"_105":106},"1b0c1d79d753",[275],[],{"_93":276,"_95":109,"_110":277,"_112":278},"33190534d3ed",[],"Ideal for extended family or investment","5b99e8081cea",[282],[],{"_93":276,"_95":109,"_110":283,"_112":284},[],"Landscaped surroundings","f3cceecb8b40",[288],[],{"_93":276,"_95":109,"_110":289,"_112":290},[],"Private outdoor entertaining area","dca644466415",[294],[],{"_93":276,"_95":109,"_110":295,"_112":296},[],"Low-maintenance exterior finishes","cd9c8052acd2",[300],[],{"_93":276,"_95":109,"_110":301,"_112":119},[],"ce376f3ba3c0",[305],[],{"_93":276,"_95":109,"_110":306,"_112":307},[],"Split-system heating and cooling","1538dd7e8ff7",[311],[],{"_93":276,"_95":109,"_110":312,"_112":313},[],"Modern bathroom with quality fixtures","0766a2137423",[317],[],{"_93":276,"_95":109,"_110":318,"_112":319},[],"Premium cabinetry and joinery","c65ddb0313b0",[323],[],{"_93":276,"_95":109,"_110":324,"_112":325},[],"Designer kitchen with stone benchtops","bf688d9c858d",[329],[],{"_93":276,"_95":109,"_110":330,"_112":331},[],"Open-plan kitchen, living and dining area","2f163dca4d85",[335],[],{"_93":276,"_95":109,"_110":336,"_112":337},[],"Fully self-contained residence","76a353760262",[341],[],{"_93":276,"_95":109,"_110":342,"_112":343},[],"Contemporary architectural design","00a08aa6cba7",[347],[],{"_93":276,"_95":109,"_110":348,"_112":186},[],"63cababd0d50",[352],[],{"_93":276,"_95":109,"_110":353,"_112":354},[],"Siari Build designed and constructed a contemporary granny flat that combines efficient use of space with premium finishes and quality workmanship. Through intelligent planning, modern design principles and attention to detail, the residence delivers comfortable everyday living while adding significant value and flexibility to the property.\nEvery stage of the project was carefully managed to ensure a smooth construction process and an exceptional finished result.","59858cab1358",[358],[],{"_93":276,"_95":109,"_110":359,"_112":204},[],"22d20b18c6ca",[363],[],{"_93":276,"_95":109,"_110":364,"_112":365},[],"The objective was to create a modern, self-contained residence within an existing property while ensuring the new dwelling complemented the main home and maximised the available land. Careful planning was required to optimise privacy, natural light, outdoor living and functionality, all while complying with planning and building regulations.","1a775156cdd0",[369],[],{"_93":276,"_95":109,"_110":370,"_112":222},[],"51125c4b4127",[374],[],{"_93":276,"_95":109,"_110":375,"_112":376},[],"This project demonstrates Siari Build’s ability to deliver practical, high-quality homes that make the most of every square metre while maintaining the same level of craftsmanship found in our larger custom homes.","d93c0484ec62",[380],[],{"_93":276,"_95":109,"_110":381,"_112":382},[],"The Reservoir Granny Flat is a contemporary custom-built secondary residence designed to maximise functionality, comfort and long-term value on an established suburban allotment. Despite its compact footprint, the home offers spacious open-plan living, premium finishes and modern architectural styling, making it ideal for extended family accommodation, guest living or investment purposes.","8686f08fba8d",[386],[],{"_93":387,"_95":109,"_110":388,"_112":241},"bba31a6db041",[],"67eb3084-d449-40e8-b5ac-d90a0c27d3e8",[399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420],{"_59":30,"_60":29,"_61":62,"_63":395,"_65":396,"_67":397,"_69":398},"https://cdn.sanity.io/images/f0yvhrzy/production/282bea05cada67cc1557dae333cdcf06f8afae57-1000x667.jpg","brunswick-transformation","Brunswick Transformation","6 months","Brunswick, VIC","150 sqm","2019",{"_93":545,"_95":96,"_97":546,"_103":547,"_105":238},{"_93":539,"_95":96,"_97":540,"_103":541,"_105":106},{"_93":533,"_95":96,"_97":534,"_103":535,"_105":106},{"_93":528,"_95":96,"_97":529,"_103":530,"_105":183},{"_93":522,"_95":96,"_97":523,"_103":524,"_105":106},{"_93":516,"_95":96,"_97":517,"_103":518,"_105":106},{"_93":511,"_95":96,"_97":512,"_103":513,"_105":183},{"_93":505,"_95":96,"_97":506,"_103":507,"_105":106},{"_93":499,"_95":96,"_97":500,"_103":501,"_105":106},{"_93":494,"_95":96,"_97":495,"_103":496,"_105":183},{"_93":488,"_95":96,"_97":489,"_99":100,"_101":102,"_103":490,"_105":106},{"_93":482,"_95":96,"_97":483,"_99":100,"_101":102,"_103":484,"_105":106},{"_93":476,"_95":96,"_97":477,"_99":100,"_101":102,"_103":478,"_105":106},{"_93":470,"_95":96,"_97":471,"_99":100,"_101":102,"_103":472,"_105":106},{"_93":464,"_95":96,"_97":465,"_99":100,"_101":102,"_103":466,"_105":106},{"_93":458,"_95":96,"_97":459,"_99":100,"_101":102,"_103":460,"_105":106},{"_93":452,"_95":96,"_97":453,"_99":100,"_101":102,"_103":454,"_105":106},{"_93":446,"_95":96,"_97":447,"_99":100,"_101":102,"_103":448,"_105":106},{"_93":440,"_95":96,"_97":441,"_99":100,"_101":102,"_103":442,"_105":106},{"_93":434,"_95":96,"_97":435,"_99":100,"_101":102,"_103":436,"_105":106},{"_93":428,"_95":96,"_97":429,"_99":100,"_101":102,"_103":430,"_105":106},{"_93":421,"_95":96,"_97":422,"_99":100,"_101":102,"_103":423,"_105":106},"521517b575e8",[424],[],{"_93":425,"_95":109,"_110":426,"_112":427},"0467201d28ce",[],"High-quality craftsmanship throughout","63f8a2629371",[431],[],{"_93":425,"_95":109,"_110":432,"_112":433},[],"Blending original character with contemporary design","7daedc0bdfdb",[437],[],{"_93":425,"_95":109,"_110":438,"_112":439},[],"Significant increase in property value","48d55f16e3e0",[443],[],{"_93":425,"_95":109,"_110":444,"_112":445},[],"Functional family floorplan","6d1d7ed3cbfb",[449],[],{"_93":425,"_95":109,"_110":450,"_112":451},[],"Modern fixtures and fittings","12e521ebfeb8",[455],[],{"_93":425,"_95":109,"_110":456,"_112":457},[],"New lighting and electrical upgrades","f9835fb6c5a2",[461],[],{"_93":425,"_95":109,"_110":462,"_112":463},[],"Premium flooring throughout","c6c4f30b1a10",[467],[],{"_93":425,"_95":109,"_110":468,"_112":469},[],"Fully renovated bathrooms","10ac91b33cae",[473],[],{"_93":425,"_95":109,"_110":474,"_112":475},[],"Designer kitchen with premium finishes","556c155f8362",[479],[],{"_93":425,"_95":109,"_110":480,"_112":481},[],"Contemporary open-plan living design","0a245955a5fb",[485],[],{"_93":425,"_95":109,"_110":486,"_112":487},[],"Original façade retained and enhanced","331167121285",[491],[],{"_93":425,"_95":109,"_110":492,"_112":493},[],"Complete internal renovation","7c0f50d4a8d3",[497],[],{"_93":425,"_95":109,"_110":498,"_112":186},[],"5249650a320d",[502],[],{"_93":425,"_95":109,"_110":503,"_112":504},[],"Through detailed planning and quality craftsmanship, we delivered a home that feels entirely new while respecting the history of the original residence.","273e073527d7",[508],[],{"_93":425,"_95":109,"_110":509,"_112":510},[],"Siari Build carefully retained the original architectural elements that defined the home’s character while completely transforming the interior to suit modern family living. The renovation included a new open-plan layout, upgraded kitchen and bathrooms, premium finishes, new flooring and contemporary lighting throughout.","9de8450e03bf",[514],[],{"_93":425,"_95":109,"_110":515,"_112":204},[],"4bce58369a89",[519],[],{"_93":425,"_95":109,"_110":520,"_112":521},[],"As with many renovation projects, working within an existing structure required flexibility and problem-solving to ensure the finished result met modern building standards without compromising the home’s original charm.","b70aec7a6448",[525],[],{"_93":425,"_95":109,"_110":526,"_112":527},[],"The objective was to modernise an ageing home without losing its original character. Maintaining the structural integrity of the existing building while redesigning the internal layout, upgrading services and incorporating modern finishes required careful planning and detailed coordination throughout the construction process.","e9e1c760f2de",[531],[],{"_93":425,"_95":109,"_110":532,"_112":222},[],"bc25cff8009a",[536],[],{"_93":425,"_95":109,"_110":537,"_112":538},[],"The project significantly increased the property’s value while delivering a home that feels both contemporary and functional.","91f069301ca9",[542],[],{"_93":425,"_95":109,"_110":543,"_112":544},[],"The Brunswick Renovation involved the complete transformation of a 1970s double-storey brick residence into a contemporary family home while preserving its original character and street presence. By retaining the existing façade and completely reimagining the interior, this renovation successfully blended timeless architecture with modern living.","c37faabe7537",[548],[],{"_93":425,"_95":109,"_110":549,"_112":241},[],"1104f69b-626e-44c0-ae20-a51a0599a97b",[559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578],{"_59":39,"_60":38,"_61":62,"_63":395,"_65":556,"_67":557,"_69":558},"https://cdn.sanity.io/images/f0yvhrzy/production/a5361fa28e76272cff59985b20fb73b9ae8e8353-1082x726.jpg","fraser-rise-residence","Fraser Rise Residence","Fraser Rise, VIC","300 sqm","2025",{"_93":688,"_95":96,"_97":689,"_103":690,"_105":238},{"_93":682,"_95":96,"_97":683,"_103":684,"_105":106},{"_93":676,"_95":96,"_97":677,"_103":678,"_105":106},{"_93":671,"_95":96,"_97":672,"_103":673,"_105":183},{"_93":665,"_95":96,"_97":666,"_103":667,"_105":106},{"_93":660,"_95":96,"_97":661,"_103":662,"_105":183},{"_93":654,"_95":96,"_97":655,"_103":656,"_105":106},{"_93":649,"_95":96,"_97":650,"_103":651,"_105":183},{"_93":643,"_95":96,"_97":644,"_99":100,"_101":102,"_103":645,"_105":106},{"_93":637,"_95":96,"_97":638,"_99":100,"_101":102,"_103":639,"_105":106},{"_93":631,"_95":96,"_97":632,"_99":100,"_101":102,"_103":633,"_105":106},{"_93":626,"_95":96,"_97":627,"_99":100,"_101":102,"_103":628,"_105":106},{"_93":621,"_95":96,"_97":622,"_99":100,"_101":102,"_103":623,"_105":106},{"_93":615,"_95":96,"_97":616,"_99":100,"_101":102,"_103":617,"_105":106},{"_93":609,"_95":96,"_97":610,"_99":100,"_101":102,"_103":611,"_105":106},{"_93":603,"_95":96,"_97":604,"_99":100,"_101":102,"_103":605,"_105":106},{"_93":597,"_95":96,"_97":598,"_99":100,"_101":102,"_103":599,"_105":106},{"_93":591,"_95":96,"_97":592,"_99":100,"_101":102,"_103":593,"_105":106},{"_93":585,"_95":96,"_97":586,"_99":100,"_101":102,"_103":587,"_105":106},{"_93":579,"_95":96,"_97":580,"_99":100,"_101":102,"_103":581,"_105":106},"4b62cba54ee3",[582],[],{"_93":583,"_95":109,"_110":584,"_112":119},"0565a279f1e5",[],"6e8a639e08a0",[588],[],{"_93":583,"_95":109,"_110":589,"_112":590},[],"Landscaped outdoor entertaining area","d364a05347c7",[594],[],{"_93":583,"_95":109,"_110":595,"_112":596},[],"Double garage","0259bf041217",[600],[],{"_93":583,"_95":109,"_110":601,"_112":602},[],"Engineered timber flooring","b5791400fc8c",[606],[],{"_93":583,"_95":109,"_110":607,"_112":608},[],"Luxury bathrooms with premium fixtures","1e24d983000c",[612],[],{"_93":583,"_95":109,"_110":613,"_112":614},[],"High ceilings throughout","de20ef939cf9",[618],[],{"_93":583,"_95":109,"_110":619,"_112":620
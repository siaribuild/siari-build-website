58},[],"Approximately 44 squares each","8ff5cb71e915",[662],[],{"_83":583,"_85":99,"_100":663,"_102":664},[],"Two luxury side-by-side townhouses","b11580ffb5c7",[668],[],{"_83":583,"_85":99,"_100":669,"_102":176},[],"df467fc39d11",[673],[],{"_83":583,"_85":99,"_100":674,"_102":675},[],"Each townhouse features premium materials, bespoke joinery, expansive living areas and carefully considered architectural detailing. By maintaining strict quality control throughout construction, we successfully delivered two luxury homes that reflect our commitment to craftsmanship, functionality and timeless design.","724b6453b60d",[679],[],{"_83":583,"_85":99,"_100":680,"_102":681},[],"Siari Build managed the project from concept through to completion, delivering two architecturally designed residences finished to an exceptional standard.","100fe32f7797",[685],[],{"_83":583,"_85":99,"_100":686,"_102":194},[],"a134636c5eee",[690],[],{"_83":583,"_85":99,"_100":691,"_102":692},[],"Delivering two high-end residences simultaneously demanded exceptional project management, precise scheduling and close collaboration between consultants, suppliers and trades throughout the construction process.","4f5357a37777",[696],[],{"_83":583,"_85":99,"_100":697,"_102":698},[],"The vision was to create two luxury homes that offered the space and quality of standalone residences while maximising the site’s development potential. Achieving this required careful planning, structural coordination and meticulous attention to detail to ensure both homes delivered a premium living experience without compromise.","edca02b88ace",[702],[],{"_83":583,"_85":99,"_100":703,"_102":212},[],"988512f026bf",[707],[],{"_83":583,"_85":99,"_100":708,"_102":709},[],"Completed in one of Melbourne’s sought-after bayside suburbs, this development showcases Siari Build’s expertise in delivering architecturally designed multi-dwelling projects that maximise both lifestyle and long-term value.","67a8a1ece2d5",[713],[],{"_83":583,"_85":99,"_100":714,"_102":715},[],"The Seaholme Residences comprise two luxury side-by-side townhouses designed to deliver contemporary architecture, premium finishes and exceptional family living. Each residence spans approximately 44 squares, combining spacious interiors with sophisticated design and high-end craftsmanship throughout.","b7cdaf8c3b4b",[719],[],{"_83":583,"_85":99,"_100":720,"_102":231},[],"bc01d88f-e939-4efd-83db-896c0ea52f50",[729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753,754],{"_49":31,"_50":30,"_51":52,"_53":385,"_55":727,"_57":728,"_59":240},"https://cdn.sanity.io/images/f0yvhrzy/production/ad540568630063cd2cea94b18ec7430e701698a1-1186x662.jpg","ellis-close-residence","Ellis Close Residence","Sanctuary Lakes, VIC","560 sqm",{"_83":901,"_85":86,"_87":902,"_93":903,"_95":228},{"_83":895,"_85":86,"_87":896,"_93":897,"_95":96},{"_83":889,"_85":86,"_87":890,"_93":891,"_95":96},{"_83":884,"_85":86,"_87":885,"_93":886,"_95":173},{"_83":878,"_85":86,"_87":879,"_93":880,"_95":96},{"_83":872,"_85":86,"_87":873,"_93":874,"_95":96},{"_83":867,"_85":86,"_87":868,"_93":869,"_95":173},{"_83":861,"_85":86,"_87":862,"_93":863,"_95":96},{"_83":855,"_85":86,"_87":856,"_93":857,"_95":96},{"_83":849,"_85":86,"_87":850,"_93":851,"_95":96},{"_83":844,"_85":86,"_87":845,"_93":846,"_95":173},{"_83":838,"_85":86,"_87":839,"_89":90,"_91":92,"_93":840,"_95":96},{"_83":832,"_85":86,"_87":833,"_89":90,"_91":92,"_93":834,"_95":96},{"_83":826,"_85":86,"_87":827,"_89":90,"_91":92,"_93":828,"_95":96},{"_83":820,"_85":86,"_87":821,"_89":90,"_91":92,"_93":822,"_95":96},{"_83":814,"_85":86,"_87":815,"_89":90,"_91":92,"_93":816,"_95":96},{"_83":808,"_85":86,"_87":809,"_89":90,"_91":92,"_93":810,"_95":96},{"_83":802,"_85":86,"_87":803,"_89":90,"_91":92,"_93":804,"_95":96},{"_83":796,"_85":86,"_87":797,"_89":90,"_91":92,"_93":798,"_95":96},{"_83":790,"_85":86,"_87":791,"_89":90,"_91":92,"_93":792,"_95":96},{"_83":784,"_85":86,"_87":785,"_89":90,"_91":92,"_93":786,"_95":96},{"_83":778,"_85":86,"_87":779,"_89":90,"_91":92,"_93":780,"_95":96},{"_83":773,"_85":86,"_87":774,"_89":90,"_91":92,"_93":775,"_95":96},{"_83":768,"_85":86,"_87":769,"_89":90,"_91":92,"_93":770,"_95":96},{"_83":762,"_85":86,"_87":763,"_89":90,"_91":92,"_93":764,"_95":96},{"_83":755,"_85":86,"_87":756,"_89":90,"_91":92,"_93":757,"_95":96},"0a31b3f0304f",[758],[],{"_83":759,"_85":99,"_100":760,"_102":761},"bbd249cc1239",[],"Energy-efficient construction with premium insulation","57c7e5bfc0b4",[765],[],{"_83":759,"_85":99,"_100":766,"_102":767},[],"Seamless indoor-outdoor entertaining spaces","35d9dac974a0",[771],[],{"_83":759,"_85":99,"_100":772,"_102":285},[],"a9a106c08ac1",[776],[],{"_83":759,"_85":99,"_100":777,"_102":622},[],"18891aaa592b",[781],[],{"_83":759,"_85":99,"_100":782,"_102":783},[],"Designer kitchen with premium appliances and butler’s pantry","a06c9df3aff7",[787],[],{"_83":759,"_85":99,"_100":788,"_102":789},[],"Feature fireplace with full-height marble surround","1f812dc1a444",[793],[],{"_83":759,"_85":99,"_100":794,"_102":795},[],"Premium natural stone throughout","7605620693ef",[799],[],{"_83":759,"_85":99,"_100":800,"_102":801},[],"Floor-to-ceiling architectural glazing","d4979ebcb8da",[805],[],{"_83":759,"_85":99,"_100":806,"_102":807},[],"Grand double-height entrance with feature void","646f4e87cc4c",[811],[],{"_83":759,"_85":99,"_100":812,"_102":813},[],"3-metre ceilings throughout","7562a0488efd",[817],[],{"_83":759,"_85":99,"_100":818,"_102":819},[],"Golf course frontage with uninterrupted views","0dd95b0424b3",[823],[],{"_83":759,"_85":99,"_100":824,"_102":825},[],"Dedicated home theatre","171c0b3c54ea",[829],[],{"_83":759,"_85":99,"_100":830,"_102":831},[],"Architectural spiral staircase","fa6e3ce20582",[835],[],{"_83":759,"_85":99,"_100":836,"_102":837},[],"Resort-style swimming pool and integrated spa","3954fb470a93",[841],[],{"_83":759,"_85":99,"_100":842,"_102":843},[],"Approximately 560sqm luxury custom residence","fbab83152d9e",[847],[],{"_83":759,"_85":99,"_100":848,"_102":176},[],"80c87fa69f03",[852],[],{"_83":759,"_85":99,"_100":853,"_102":854},[],"By managing every stage of the project—from planning and approvals through to construction and final handover—we delivered a residence that exceeds expectations in both design and quality.","1b6ab343c2f3",[858],[],{"_83":759,"_85":99,"_100":859,"_102":860},[],"The home features expansive floor-to-ceiling glazing to capture natural light and golf course views, premium natural stone throughout, custom-designed joinery and carefully selected finishes that create a warm yet luxurious atmosphere. A feature spiral staircase, resort-style swimming pool and spa, dedicated home theatre and thoughtfully designed entertaining spaces ensure the home is equally suited to everyday family living and entertaining.","669bc94a5e64",[864],[],{"_83":759,"_85":99,"_100":865,"_102":866},[],"Working closely with the client from concept through to completion, Siari Build delivered a bespoke residence that combines sophisticated architectural design with exceptional craftsmanship.","85ac23bcc30d",[870],[],{"_83":759,"_85":99,"_100":871,"_102":194},[],"1b0b2ab6b1c7",[875],[],{"_83":759,"_85":99,"_100":876,"_102":877},[],"Delivering these design aspirations required meticulous planning, precise construction techniques and uncompromising attention to detail across every stage of the project.","ec82d360fbc4",[881],[],{"_83":759,"_85":99,"_100":882,"_102":883},[],"The vision was to create a home that maximised its unique golf course position while delivering a luxurious yet highly functional family residence. The brief called for generous open-plan living, abundant natural light, seamless indoor-outdoor integration and premium architectural detailing throughout, all while maintaining privacy, energy efficiency and timeless appeal.","bb5c14481adb",[887],[],{"_83":759,"_85":99,"_100":888,"_102":212},[],"e9dfcc8f56d9",[892],[],{"_83":759,"_85":99,"_100":893,"_102":894},[],"Featuring expansive glazing, soaring ceilings, premium natural stone, a resort-style swimming pool and spa, and a striking architectural spiral staircase, every element has been carefully considered to create a timeless home that embraces luxury, comfort and indoor-outdoor living.","bd2037495198",[898],[],{"_83":759,"_85":99,"_100":899,"_102":900},[],"The Ellis Close Residence is a luxury custom home designed to showcase contemporary architecture, exceptional craftsmanship and refined family living. Situated within the prestigious Sanctuary Lakes estate overlooking the golf course, this approximately 60sq residence seamlessly blends elegant design with everyday functionality.","de8429d97b62",[904],[],{"_83":759,"_85":99,"_100":905,"_102":231},[],"8e82052a-d955-4b54-a3e7-9f373906a22d",[915,916,917,918,919,920,921,922,923,924,925,926,927,928,929,930,931,932,933,934,935],{"_49":31,"_50":30,"_51":52,"_53":912,"_55":913,"_57":914,"_59":240},"https://cdn.sanity.io/images/f0yvhrzy/production/f5fa2cef3f14587503c6cc248fe6f43cf7cf679d-2400x1600.jpg","tarneit-cathedral-residence","Tarneit Cathedral Residence","3 months","Tarneit, VIC","205 sqm",{"_83":1049,"_85":86,"_87":1050,"_93":1051,"_95":228},{"_83":1043,"_85":86,"_87":1044,"_93":1045,"_95":96},{"_83":1037,"_85":86,"_87":1038,"_93":1039,"_95":96},{"_83":1032,"_85":86,"_87":1033,"_93":1034,"_95":173},{"_83":1026,"_85":86,"_87":1027,"_93":1028,"_95":96},{"_83":1021,"_85":86,"_87":1022,"_93":1023,"_95":173},{"_83":1015,"_85":86,"_87":1016,"_93":1017,"_95":96},{"_83":1010,"_85":86,"_87":1011,"_93":1012,"_95":173},{"_83":1004,"_85":86,"_87":1005,"_89":90,"_91":92,"_93":1006,"_95":96},{"_83":998,"_85":86,"_87":999,"_89":90,"_91":92,"_93":1000,"_95":96},{"_83":992,"_85":86,"_87":993,"_89":90,"_91":92,"_93":994,"_95":96},{"_83":986,"_85":86,"_87":987,"_89":90,"_91":92,"_93":988,"_95":96},{"_83":981,"_85":86,"_87":982,"_89":90,"_91":92,"_93":983,"_95":96},{"_83":975,"_85":86,"_87":976,"_89":90,"_91":92,"_93":977,"_95":96},{"_83":970,"_85":86,"_87":971,"_89":90,"_91":92,"_93":972,"_95":96},{"_83":964,"_85":86,"_87":965,"_89":90,"_91":92,"_93":966,"_95":96},{"_83":958,"_85":86,"_87":959,"_89":90,"_91":92,"_93":960,"_95":96},{"_83":953,"_85":86,"_87":954,"_89":90,"_91":92,"_93":955,"_95":96},{"_83":948,"_85":86,"_87":949,"_89":90,"_91":92,"_93":950,"_95":96},{"_83":942,"_85":86,"_87":943,"_89":90,"_91":92,"_93":944,"_95":96},{"_83":936,"_85":86,"_87":937,"_89":90,"_91":92,"_93":938,"_95":96},"9ffcd6ec3c35",[939],[],{"_83":940,"_85":99,"_100":941,"_102":267},"3ca65d6deab5",[],"0a5576c26fb6",[945],[],{"_83":940,"_85":99,"_100":946,"_102":947},[],"Landscaped front and rear yards","9709225d069b",[951],[],{"_83":940,"_85":99,"_100":952,"_102":279},[],"4a9436cefb09",[956],[],{"_83":940,"_85":99,"_100":957,"_102":315},[],"53e71389d3bc",[961],[],{"_83":940,"_85":99,"_100":962,"_102":963},[],"Premium bathrooms with quality fixtures","a56feefc4804",[967],[],{"_83":940,"_85":99,"_100":968,"_102":969},[],"Tiled flooring throughout living areas","84375ecf30ce",[973],[],{"_83":940,"_85":99,"_100":974,"_102":309},[],"2354d8b33592",[978],[],{"_83":940,"_85":99,"_100":979,"_102":980},[],"Refrigerated heating and cooling","89cc6c9d9f60",[984],[],{"_83":940,"_85":99,"_100":985,"_102":327},[],"a98313c1dea2",[989],[],{"_83":940,"_85":99,"_100":990,"_102":991},[],"Feature cathedral ceiling","1305b6c70db4",[995],[],{"_83":940,"_85":99,"_100":996,"_102":997},[],"Completed in just 3 months","e78f3fe8b087",[1001],[],{"_83":940,"_85":99,"_100":1002,"_102":1003},[],"Built on a compact 240sqm allotment","86cd1d0f95a9",[1007],[],{"_83":940,"_85":99,"_100":1008,"_102":1009},[],"Approximately 205sqm (22 Squares) custom residence","ff4b3e2b5912",[1013],[],{"_83":940,"_85":99,"_100":1014,"_102":176},[],"782d0c018f67",[1018],[],{"_83":940,"_85":99,"_100":1019,"_102":1020},[],"Through intelligent design, efficient project management and close coordination with trades, Siari Build successfully delivered a spacious and functional custom home in just three months. Open-plan living, quality materials and carefully selected finishes create a modern residence that offers exceptional value while exceeding the client’s expectations.","a3c6f6928eef",[1024],[],{"_83":940,"_85":99,"_100":1025,"_102":194},[],"a0f37d40bcae",[1029],[],{"_83":940,"_85":99,"_100":1030,"_102":1031},[],"Designing a comfortable family home on a compact 240sqm block required careful planning to maximise internal living space while maintaining a practical layout, natural light and street appeal. The objective was to create a home that felt significantly larger than its footprint while delivering premium finishes within an efficient construction timeframe.","18576792e97c",[1035],[],{"_83":940,"_85":99,"_100":1036,"_102":212},[],"46168750c9d6",[1040],[],{"_83":940,"_85":99,"_100":1041,"_102":1042},[],"Completed in just three months, the project demonstrates Siari Build’s ability to deliver high-quality homes efficiently without compromising craftsmanship or attention to detail.","a1e241a503c7",[1046],[],{"_83":940,"_85":99,"_100":1047,"_102":1048},[],"The Tarneit Cathedral Residence is a contemporary custom home designed to maximise space, natural light and functionality on a compact 240sqm allotment. Despite the site’s size, this 22-square residence delivers a spacious and modern family environment through clever design, quality finishes and efficient use of every square metre.","a3c9646c59f8",[1052],[],{"_83":940,"_85":99,"_100":1053,"_102":231},[],"1409634c-755f-453b-9a37-67bb91b98f06",[1060,1061,1062,1063,1064,1065,1066,1067,1068,1069,1070,1071,1072,1073,1074,1075,1076,1077,1078,1079,1080,1081,1082,1083,1084,1085,1086],{"_49":31,"_50":30,"_51":52,"_53":385,"_55":727,"_57":728,"_59":553},"https://cdn.sanity.io/images/f0yvhrzy/production/582a165b97f8c831542de3f4474d9073936c9440-1536x1024.jpg","tiffany-walk-residence","Tiffany Walk Residence",{"_83":1230,"_85":86,"_87":1231,"_93":1232,"_95":228},{"_83":1224,"_85":86,"_87":1225,"_93":1226,"_95":96},{"_83":1218,"_85":86,"_87":1219,"_93":1220,"_95":96},{"_83":1213,"_85":86,"_87":1214,"_93":1215,"_95":173},{"_83":1207,"_85":86,"_87":1208,"_93":1209,"_95":96},{"_83":1201,"_85":86,"_87":1202,"_93":1203,"_95":96},{"_83":1196,"_85":86,"_87":1197,"_93":1198,"_95":173},{"_83":1190,"_85":86,"_87":1191,"_93":1192,"_95":96},{"_83":1184,"_85":86,"_87":1185,"_93":1186,"_95":96},{"_83":1178,"_85":86,"_87":1179,"_93":1180,"_95":96},{"_83":1173,"_85":86,"_87":1174,"_93":1175,"_95":173},{"_83":1167,"_85":86,"_87":1168,"_89":90,"_91":92,"_93":1169,"_95":96},{"_83":1161,"_85":86,"_87":1162,"_89":90,"_91":92,"_93":1163,"_95":96},{"_83":1156,"_85":86,"_87":1157,"_89":90,"_91":92,"_93":1158,"_95":96},{"_83":1151,"_85":86,"_87":1152,"_89":90,"_91":92,"_93":1153,"_95":96},{"_83":1146,"_85":86,"_87":1147,"_89":90,"_91":92,"_93":1148,"_95":96},{"_83":1141,"_85":86,"_87":1142,"_89":90,"_91":92,"_93":1143,"_95":96},{"_83":1136,"_85":86,"_87":1137,"_89":90,"_91":92,"_93":1138,"_95":96},{"_83":1131,"_85":86,"_87":1132,"_89":90,"_91":92,"_93":1133,"_95":96},{"_83":1125,"_85":86,"_87":1126,"_89":90,"_91":92,"_93":1127,"_95":96},{"_83":1120,"_85":86,"_87":1121,"_89":90,"_91":92,"_93":1122,"_95":96},{"_83":1115,"_85":86,"_87":1116,"_89":90,"_91":92,"_93":1117,"_95":96},{"_83":1110,"_85":86,"_87":1111,"_89":90,"_91":92,"_93":1112,"_95":96},{"_83":1105,"_85":86,"_87":1106,"_89":90,"_91":92,"_93":1107,"_95":96},{"_83":1099,"_85":86,"_87":1100,"_89":90,"_91":92,"_93":1101,"_95":96},{"_83":1094,"_85":86,"_87":1095,"_89":90,"_91":92,"_93":1096,"_95":96},{"_83":1087,"_85":86,"_87":1088,"_89":90,"_91":92,"_93":1089,"_95":96},"249fa7fca2c7",[1090],[],{"_83":1091,"_85":99,"_100":1092,"_102":1093},"cd808d0de756",[],"Luxury landscaping and architectural façade","e9fe700dc304",[1097],[],{"_83":1091,"_85":99,"_100":1098,"_102":267},[],"1d830c37c487",[1102],[],{"_83":1091,"_85":99,"_100":1103,"_102":1104},[],"Multiple indoor and outdoor entertaining areas","3a9fa4e6b67a",[1108],[],{"_83":1091,"_85":99,"_100":1109,"_102":285},[],"9e79372099b2",[1113],[],{"_83":1091,"_85":99,"_100":1114,"_102":622},[],"3a9fa2e060d4",[1118],[],{"_83":1091,"_85":99,"_100":1119,"_102":783},[],"fdaddf99d9a1",[1123],[],{"_83":1091,"_85":99,"_100":1124,"_102":789},[],"9e629aeafb66",[1128],[],{"_83":1091,"_85":99,"_100":1129,"_102":1130},[],"Premium marble and natural stone throughout","e5cf8968932b",[1134],[],{"_83":1091,"_85":99,"_100":1135,"_102":801},[],"c97a58816d63",[1139],[],{"_83":1091,"_85":99,"_100":1140,"_102":813},[],"d57d39bde4f5",[1144],[],{"_83":1091,"_85":99,"_100":1145,"_102":807},[],"12834a1e2883",[1149],[],{"_83":1091,"_85":99,"_100":1150,"_102":825},[],"ef6b92bd34cc",[1154],[],{"_83":1091,"_85":99,"_100":1155,"_102":831},[],"23a12f193411",[1159],[],{"_83":1091,"_85":99,"_100":1160,"_102":837},[],"de574eb36a64",[1164],[],{"_83":1091,"_85":99,"_100":1165,"_102":1166},[],"Prestigious golf course frontage","6bc0db9aab57",[1170],[],{"_83":1091,"_85":99,"_100":1171,"_102":1172},[],"Approximately 560sqm (60 Squares) custom residence","e311ce228169",[1176],[],{"_83":1091,"_85":99,"_100":1177,"_102":176},[],"2839ad7792ad",[1181],[],{"_83":1091,"_85":99,"_100":1182,"_102":1183},[],"By managing every stage of the project—from design coordination and approvals through to construction and final handover—we delivered a residence that exceeds expectations in both quality and design.","6ca1b477e11e",[1187],[],{"_83":1091,"_85":99,"_100":1188,"_102":1189},[],"The home features a dramatic double-height entrance, a custom spiral staircase, premium natural stone finishes, bespoke joinery and expansive floor-to-ceiling glazing that frames the surrounding golf course. A resort-style swimming pool and spa create a seamless connection between the indoor living spaces and the outdoor entertaining area, while every material and finish was carefully selected to deliver a timeless, luxurious home.","21f58fd85f3c",[1193],[],{"_83":1091,"_85":99,"_100":1194,"_102":1195},[],"Working closely with the client from concept through to completion, Siari Build delivered a bespoke residence that combines sophisticated architectural design with superior craftsmanship.","c1bf7876449a",[1199],[],{"_83":1091,"_85":99,"_100":1200,"_102":194},[],"0e9fe8d1d23f",[1204],[],{"_83":1091,"_85":99,"_100":1205,"_102":1206},[],"Executing these design ambitions demanded meticulous planning, precision construction and exceptional attention to detail across every stage of the project.","8e1a3fec833b",[1210],[],{"_83":1091,"_85":99,"_100":1211,"_102":1212},[],"The vision was to create a statement residence that maximised its premium golf course location while delivering uncompromising luxury and everyday practicality. The design required expansive open-plan living, abundant natural light, seamless indoor-outdoor integration and premium architectural detailing throughout, while maintaining privacy, energy efficiency and timeless appeal.","377ee23dc1ca",[1216],[],{"_83":1091,"_85":99,"_100":1217,"_102":212},[],"a581b14364f3",[1221],[],{"_83":1091,"_85":99,"_100":1222,"_102":1223},[],"Positioned within the prestigious Sanctuary Lakes estate overlooking the golf course, the home seamlessly integrates indoor and outdoor living through floor-to-ceiling glazing, a resort-style swimming pool and spa, and generous entertaining spaces. Every aspect of the residence has been meticulously designed to create a home that is both luxurious and functional.","af2624f57fe4",[1227],[],{"_83":1091,"_85":99,"_100":1228,"_102":1229},[],"The Tiffany Walk Residence is a luxury custom home designed to deliver timeless architecture, exceptional craftsmanship and resort-style family living. Spanning approximately 560sqm (60 Squares), this residence showcases premium finishes, expansive living spaces and carefully considered architectural details throughout.","6d3fc6ef7496",[1233],[],{"_83":1091,"_85":99,"_100":1234,"_102":231},[],"sections",[1239,1240,1241,1242],"seo","Projects",{"_83":1321,"_85":1322,"_1245":1323,"_1246":-5,"_1247":-5,"_1249":-5,"_1251":-5,"_1253":-5,"_1254":-5,"_1255":-5,"_1256":-5,"_1257":-5,"_1258":1324,"_1260":-5,"_1261":1325,"_1263":1326,"_1264":-5,"_1265":-5,"_1266":-5,"_1267":-5,"_1268":-5,"_1269":-5,"_1270":-5,"_1271":-5,"_1272":-5,"_1273":1327,"_1274":-5,"_102":-5,"_1275":-5},{"_83":1286,"_85":1287,"_1245":-5,"_1246":-5,"_1247":-5,"_1249":-5,"_1251":-5,"_1253":-5,"_1254":-5,"_1255":-5,"_1256":-5,"_1257":-5,"_1258":1288,"_1260":-5,"_1261":1289,"_1263":-5,"_1264":1290,"_1265":1291,"_1266":1292,"_1267":-5,"_1268":-5,"_1269":-5,"_1270":-5,"_1271":-5,"_1272":1293,"_1273":-5,"_1274":-5,"_102":1294,"_1275":1276},{"_83":1283,"_85":1284,"_1245":-5,"_1246":-5,"_1247":-5,"_1249":-5,"_1251":-5,"_1253":-5,"_1254":-5,"_1255":-5,"_1256":-5,"_1257":-5,"_1258":-5,"_1260":-5,"_1261":-5,"_1263":-5,"_1264":-5,"_1265":-5,"_1266":-5,"_1267":-5,"_1268":-5,"_1269":-5,"_1270":-5,"_1271":-5,"_1272":-5,"_1273":-5,"_1274":-5,"_102":-5,"_1275":1285},{"_83":1243,"_85":1244,"_1245":-5,"_1246":-5,"_1247":1248,"_1249":1250,"_1251":1252,"_1253":-5,"_1254":-5,"_1255":-5,"_1256":-5,"_1257":-5,"_1258":1259,"_1260":-5,"_1261":1262,"_1263":-5,"_1264":-5,"_1265":-5,"_1266":-5,"_1267":-5,"_1268":-5,"_1269":-5,"_1270":-5,"_1271":-5,"_1272":-5,"_1273":-5,"_1274":-5,"_102":-5,"_1275":1276},"5d2efe39fee4","ctaBlock","backgroundImage","backgroundImageHotspot","body","Like what you see? Let's talk about what we'd build for you.","buttonLabel","Start Your Project","buttonLink",{"_1277":-5,"_1278":1279,"_1280":1278,"_1281":-5},"cards","columns","content","ctaLabel","ctaLink","eyebrow","Get Started","formHeading","heading","YOUR PROJECT BELONGS HERE","height","image","imagePosition","imageSize","infoHeading","primaryButtonLabel","primaryButtonLink","secondaryButtonLabel","secondaryButtonLink","stats","subheading","testimonials","theme","light","href","internal",{"_85":7,"_22":1282},"kind","newTab","contact","f3d170d7b727","projectsGrid","gray","f4a3a8cab2f2","textImage","Our Portfolio","FOURTEEN YEARS,\nBUILT TO LAST","https://cdn.sanity.io/images/f0yvhrzy/production/dbc2b4a5f032554b5f5aea0f2de731c02ecc52ce-4000x2500.jpg","right","medium",[1310,1311,1312],[1295,1296],{"_83":1304,"_85":86,"_87":1305,"_93":1306,"_95":96},{"_83":1297,"_85":86,"_87":1298,"_93":1299,"_95":96},"93913e652443",[1300],[],{"_83":1301,"_85":99,"_100":1302,"_102":1303},"cf40006f8f29",[],"Scale doesn't change the standard. A granny flat and a multi-million-dollar residence get the same attention to detail. Have a look — and picture yours here.","18e03cf3a856",[1307],[],{"_83":1301,"_85":99,"_100":1308,"_102":1309},[],"Every project here is a real collaboration — a client's vision, our team's craft, and a site with its own quirks to solve. From contemporary custom homes to sensitive renovations, this is the full range of what we do.",{"_1313":1319,"_1315":1320},{"_1313":1317,"_1315":1318},{"_1313":1314,"_1315":1316},"label","Quality","value","100%","delivered","$50M+","years","14+","1ebb1cc02aa1","heroInner","https://cdn.sanity.io/images/f0yvhrzy/production/1a2d64029694c5b60f8bed8a25c03eb95042143c-6000x3373.jpg"," Selected Work","OUR PROJECTS","tall","Custom homes, bespoke builds, developments and renovations — delivered across Melbourne and built to be lived in for the long haul.",{"_1329":1330,"_1331":1332},"settings",{"_1370":1371,"_1372":1373,"_1374":1375,"_1376":1377,"_1378":1336,"_1379":1380,"_1381":-5,"_1382":1383,"_1384":1336,"_1385":-5,"_1386":-5,"_1387":-5,"_1388":1389,"_1390":1391,"_1392":-5,"_1393":1394,"_1395":1396,"_1397":1398,"_1399":1400,"_1401":1402},"navigation",{"_1333":1334,"_1335":1336,"_1337":1338,"_1339":1340},"footerMenu",[1363,1364,1365,1366,1367],"headerCtaEnabled",true,"headerMenu",[1352,1353,1354,1355],"socialMenu",[1341,1342,1343],{"_1344":-5,"_1313":1350,"_1346":1351},{"_1344":-5,"_1313":1348,"_1346":1349},{"_1344":-5,"_1313":1345,"_1346":1347},"icon","Hauzz","url","http://houzz.com","Instagram","http://insta.com","Facebook","http:\\\\facebook.com",{"_1313":-5,"_1356":1361,"_1357":1362},{"_1313":-5,"_1356":1359,"_1357":1360},{"_1313":-5,"_1356":12,"_1357":1238},{"_1313":1250,"_1356":1282,"_1357":1358},"pageSlug","pageTitle","Contact","about","About","home","Home",{"_1313":-5,"_1356":1361,"_1357":1362},{"_1313":-5,"_1356":1359,"_1357":1360},{"_1313":-5,"_1356":12,"_1357":1238},{"_1313":-5,"_1356":1282,"_1357":1358},{"_1313":-5,"_1356":1368,"_1357":1369},"privacy-policy","Privacy Policy","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapLocation","mapZoom","notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","siteName","Siari Build","tagline","We don't just build houses. We build the next forty years of your life.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed"]

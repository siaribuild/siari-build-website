2},[],"46168750c9d6",[992],[],{"_93":892,"_95":109,"_110":993,"_112":994},[],"Completed in just three months, the project demonstrates Siari Build’s ability to deliver high-quality homes efficiently without compromising craftsmanship or attention to detail.","a1e241a503c7",[998],[],{"_93":892,"_95":109,"_110":999,"_112":1000},[],"The Tarneit Cathedral Residence is a contemporary custom home designed to maximise space, natural light and functionality on a compact 240sqm allotment. Despite the site’s size, this 22-square residence delivers a spacious and modern family environment through clever design, quality finishes and efficient use of every square metre.","a3c9646c59f8",[1004],[],{"_93":892,"_95":109,"_110":1005,"_112":241},[],"bc01d88f-e939-4efd-83db-896c0ea52f50",[1014,1015,1016,1017,1018,1019,1020,1021,1022,1023,1024,1025,1026,1027,1028,1029,1030,1031,1032,1033,1034,1035,1036,1037,1038,1039],{"_59":39,"_60":38,"_61":62,"_63":700,"_65":1012,"_67":1013,"_69":558},"https://cdn.sanity.io/images/f0yvhrzy/production/ad540568630063cd2cea94b18ec7430e701698a1-1186x662.jpg","ellis-close-residence","Ellis Close Residence","Sanctuary Lakes, VIC","560 sqm",{"_93":1186,"_95":96,"_97":1187,"_103":1188,"_105":238},{"_93":1180,"_95":96,"_97":1181,"_103":1182,"_105":106},{"_93":1174,"_95":96,"_97":1175,"_103":1176,"_105":106},{"_93":1169,"_95":96,"_97":1170,"_103":1171,"_105":183},{"_93":1163,"_95":96,"_97":1164,"_103":1165,"_105":106},{"_93":1157,"_95":96,"_97":1158,"_103":1159,"_105":106},{"_93":1152,"_95":96,"_97":1153,"_103":1154,"_105":183},{"_93":1146,"_95":96,"_97":1147,"_103":1148,"_105":106},{"_93":1140,"_95":96,"_97":1141,"_103":1142,"_105":106},{"_93":1134,"_95":96,"_97":1135,"_103":1136,"_105":106},{"_93":1129,"_95":96,"_97":1130,"_103":1131,"_105":183},{"_93":1123,"_95":96,"_97":1124,"_99":100,"_101":102,"_103":1125,"_105":106},{"_93":1117,"_95":96,"_97":1118,"_99":100,"_101":102,"_103":1119,"_105":106},{"_93":1111,"_95":96,"_97":1112,"_99":100,"_101":102,"_103":11
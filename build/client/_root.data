5,"_670":-5,"_671":754,"_672":-5,"_673":755,"_675":-5,"_642":-5,"_676":-5,"_677":-5,"_678":-5,"_679":-5,"_680":-5,"_681":-5,"_682":-5,"_683":-5,"_684":-5,"_685":-5,"_686":-5,"_687":-5,"_85":-5,"_688":701,"_32":-5},{"_66":736,"_68":737,"_657":-5,"_658":-5,"_659":-5,"_660":-5,"_662":-5,"_664":-5,"_666":-5,"_667":-5,"_668":-5,"_669":-5,"_670":-5,"_671":-5,"_672":-5,"_673":738,"_675":-5,"_642":739,"_676":-5,"_677":740,"_678":741,"_679":-5,"_680":-5,"_681":-5,"_682":-5,"_683":-5,"_684":-5,"_685":-5,"_686":-5,"_687":-5,"_85":742,"_688":724,"_32":-5},{"_66":720,"_68":721,"_657":-5,"_658":-5,"_659":-5,"_660":-5,"_662":-5,"_664":-5,"_666":722,"_667":723,"_668":-5,"_669":-5,"_670":-5,"_671":-5,"_672":-5,"_673":-5,"_675":-5,"_642":-5,"_676":-5,"_677":-5,"_678":-5,"_679":-5,"_680":-5,"_681":-5,"_682":-5,"_683":-5,"_684":-5,"_685":-5,"_686":-5,"_687":-5,"_85":-5,"_688":724,"_32":-5},{"_66":696,"_68":697,"_657":-5,"_658":-5,"_659":-5,"_660":-5,"_662":-5,"_664":-5,"_666":-5,"_667":-5,"_668":-5,"_669":-5,"_670":-5,"_671":698,"_672":-5,"_673":699,"_675":-5,"_642":-5,"_676":-5,"_677":-5,"_678":-5,"_679":-5,"_680":-5,"_681":-5,"_682":-5,"_683":-5,"_684":-5,"_685":-5,"_686":-5,"_687":700,"_85":-5,"_688":701,"_32":-5},{"_66":655,"_68":656,"_657":-5,"_658":-5,"_659":-5,"_660":661,"_662":663,"_664":665,"_666":-5,"_667":-5,"_668":-5,"_669":-5,"_670":-5,"_671":-5,"_672":-5,"_673":674,"_675":-5,"_642":-5,"_676":-5,"_677":-5,"_678":-5,"_679":-5,"_680":-5,"_681":-5,"_682":-5,"_683":-5,"_684":-5,"_685":-5,"_686":-5,"_687":-5,"_85":-5,"_688":689,"_32":-5},"b634cec6db77","ctaBlock","backgroundImage","backgroundImageAlt","backgroundImageHotspot","body","Tell us what you're picturing. First conversation's on us — and there's no obligation to go further.","buttonLabel","Start Your Project","buttonLink",{"_690":-5,"_691":692,"_693":-5,"_694":-5},"cards","columns","content","ctaLabel","ctaLink","eyebrow","formHeading","heading","LET'S BUILD \nSOMETHING THAT LASTS.","height","imageAlt","imagePosition","imageSize","infoHeading","items","primaryButtonLabel","primaryButtonLink","secondaryButtonLabel","secondaryButtonLink","stats","subheading","testimonials","theme","gray","href","internal",{"_68":7,"_30":695},"kind","newTab","contact","04b1389c29bb","testimonialsBlock","Testimonials","IN THEIR WORDS",[702,703],"light",{"_19":714,"_705":715,"_707":716,"_709":717},{"_19":704,"_705":706,"_707":708,"_709":710},"7057d739-298e-428b-b847-9d385fcd3e7e","clientName","Michael D.","link",{"_68":711,"_30":712,"_32":713},"quote","As first-home buyers, building felt overwhelming at first, but Siari Build made the entire process straightforward and stress-free. We were kept informed every step of the way, and nothing was ever too much trouble. The quality of our home is fantastic, and it was completed on time and to a very high standard. We couldn’t be happier with our first home.","project","tarneit-cathedral-residence","Tarneit Cathedral Residence","088f5c74-5b85-45c9-b7a1-6c060acbb737","Rebecca H.",{"_68":711,"_30":718,"_32":719},"Siari Build successfully delivered our dual townhouse development with exceptional attention to detail and professionalism. Despite the challenges of building on a busy main road, the project was completed to an outstanding standard while maintaining excellent communication throughout. We would confidently recommend Siari Build to anyone looking for a builder who genuinely cares about quality.","bentleigh-east-development","Bentleigh East Development","9e60075ebc13","cardGrid",[725,726,727,728],4,"dark",{"_729":730,"_731":-5,"_85":-5,"_32":735},{"_729":730,"_731":-5,"_85":-5,"_32":734},{"_729":730,"_731":-5,"_85":-5,"_32":733},{"_729":730,"_731":-5,"_85":-5,"_32":732},"icon","data:image/svg+xml;base64,","label","Built To Last","Reliable & On Time","Straight Talk","Quality Craftsmanship","106444287130","textImage","WE BUILD \nLIKE WE'RE \nSTAYING.","https://cdn.sanity.io/images/f0yvhrzy/production/e8b08ccc948d22e9435f718a1cac23ad63581506-3331x4997.jpg","left","short",[743],{"_66":744,"_68":69,"_70":745,"_76":746,"_78":79},"9b3aa933fc0c",[747],[],{"_66":748,"_68":82,"_83":749,"_85":750},"484fdb62304d",[],"This started with homes we built for our own family. That's still the test for every project — would we be happy to live here, hand it to our kids, stand behind it in twenty years? If the answer isn't yes, it's not finished.","0a50d1faa0dd","cardGridText",[756,757,758,759],"Process","How We Work",{"_729":-5,"_731":769,"_85":770,"_32":771},{"_729":-5,"_731":766,"_85":767,"_32":768},{"_729":-5,"_731":763,"_85":764,"_32":765},{"_729":-5,"_731":760,"_85":761,"_32":762},"04","A thorough final walkthrough, then the keys. Built to last, ready to live in.","Handover","03","Precision construction with regular updates and tight quality control. You're never wondering what's happening on site.","Build","02","We coordinate drawings, engineering, permits and selections — so you deal with us, not ten different people.","Design & Approvals","01","We start with a proper conversation — your site, your budget, what you actually want. No obligation, no jargon.","Sit-Down","e9ac83420876","See All Projects",{"_690":-5,"_691":777,"_693":691,"_694":-5},"Selected Work","FEATURED \nPROJECTS",{"_68":7,"_30":13},"71fd1a0e0fde",[783,784,785,786,787,788],3,"Services","What we do",{"_729":804,"_731":-5,"_85":805,"_32":806},{"_729":801,"_731":-5,"_85":802,"_32":803},{"_729":798,"_731":-5,"_85":799,"_32":800},{"_729":795,"_731":-5,"_85":796,"_32":797},{"_729":792,"_731":-5,"_85":793,"_32":794},{"_729":789,"_731":-5,"_85":790,"_32":791},"data:image/svg+xml;base64,","Extra space for family, guests or rental income - designed and built properly, not bolted on.","Granny Flats","data:image/svg+xml;base64,","From a single kitchen to a whole-home transformation - old bones, new life.","Renovations","data:image/svg+xml;base64,","More room without the move. Ground-floor and second-storey extensions that look like they were always there.","Extensions & Additions","data:image/svg+xml;base64,","Dual occupancies and townhouses that get the most out of your site — and your return.","Multi-Dwelling Developments","data:image/svg+xml;base64,","Already have plans or an architect? We build to your design with the rigour it deserves.","Bespoke Builds","data:image/svg+xml;base64,","Architecturally led homes built around how you actually live — not a catalogue floor plan.","Custom Homes","a717a1c9a14d","Learn Our Story",{"_690":-5,"_691":838,"_693":691,"_694":-5},"About SIARI Build","BUILT ON\nDETAIL.","https://cdn.sanity.io/images/f0yvhrzy/production/dbc2b4a5f032554b5f5aea0f2de731c02ecc52ce-4000x2500.jpg","tall",[831,832],[816,817],{"_66":825,"_68":69,"_70":826,"_76":827,"_78":79},{"_66":818,"_68":69,"_70":819,"_76":820,"_78":79},"64d5f45d179f",[821],[],{"_66":822,"_68":82,"_83":823,"_85":824},"89beb2787f2c",[],"Over 14 years we've grown from renovations and carpentry into full custom homes and multi-dwelling developments across Victoria. Same hands-on standard. Bigger canvas.","07fef5af2b88",[828],[],{"_66":822,"_68":82,"_83":829,"_85":830},[],"Siari Build is a Melbourne builder for people who care how things are made. We deliver custom homes, bespoke designs and high-end renovations where the details — the joins, the lines, the finishes you run your hand across — are the whole point.",{"_731":836,"_834":837},{"_731":833,"_834":835},"delivered","value","$20M+","years","14+",{"_68":7,"_30":839},"about","216f03523a94","heroHome","https://cdn.sanity.io/images/f0yvhrzy/production/650dd2357c41a87e224539f92b3bd25147c59175-3500x2333.jpg","Melbourne custom home builders","Some builders \nfinish. We \nperfect.",{"_690":-5,"_691":850,"_693":691,"_694":-5},"See Our Work",{"_690":-5,"_691":849,"_693":691,"_694":-5},"Custom homes, bespoke builds, and transformative renovations across Melbourne — managed end to end, from the first sketch to the day you get the keys.",{"_68":7,"_30":13},{"_68":7,"_30":695},{"_852":853,"_854":855,"_856":857},"settings",{"_897":898,"_899":900,"_901":902,"_903":904,"_905":614,"_906":907,"_908":-5,"_909":910,"_911":867,"_912":-5,"_913":-5,"_914":867,"_915":916,"_917":918,"_919":920,"_921":922,"_923":-5,"_924":925,"_926":927,"_643":928,"_929":930,"_931":932},"navigation",{"_864":865,"_866":867,"_868":869,"_870":871},"services",[858,859,860,861,862,863],{"_85":805,"_32":806},{"_85":802,"_32":803},{"_85":799,"_32":800},{"_85":796,"_32":797},{"_85":793,"_32":794},{"_85":790,"_32":791},"footerMenu",[886,887,888,889,890,891],"headerCtaEnabled",true,"headerMenu",[877,878,879,880],"socialMenu",[872],{"_873":-5,"_729":-5,"_731":874,"_875":876},"hideFromMenu","Instagram","url","https://www.instagram.com/siari_build/",{"_731":-5,"_881":605,"_882":606},{"_731":-5,"_881":839,"_882":885},{"_731":-5,"_881":13,"_882":884},{"_731":663,"_881":695,"_882":883},"pageSlug","pageTitle","Contact","Projects","About",{"_731":-5,"_881":605,"_882":606},{"_731":-5,"_881":839,"_882":885},{"_731":-5,"_881":13,"_882":884},{"_731":-5,"_881":695,"_882":883},{"_731":894,"_881":895,"_882":896},{"_731":-5,"_881":892,"_882":893},"privacy-policy","Privacy Policy","FAQ","faq","Frequently Asked Questions","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapAreaRadius","mapHidePin","mapLocation",{"_68":933,"_934":935,"_936":937,"_938":939},"mapZoom",12,"notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","Siari Build","tagline","Designed to Impress. Built to Last.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed","geopoint","alt",7,"lat",-37.895696,"lng",144.76186]

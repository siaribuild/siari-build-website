15":216,"_217":338,"_223":339,"_225":226},{"_213":331,"_215":216,"_217":332,"_223":333,"_225":226},{"_213":325,"_215":216,"_217":326,"_223":327,"_225":309},{"_213":319,"_215":216,"_217":320,"_223":321,"_225":226},{"_213":313,"_215":216,"_217":314,"_223":315,"_225":226},{"_213":306,"_215":216,"_217":307,"_223":308,"_225":309},{"_213":300,"_215":216,"_217":301,"_219":220,"_221":222,"_223":302,"_225":226},{"_213":294,"_215":216,"_217":295,"_219":220,"_221":222,"_223":296,"_225":226},{"_213":288,"_215":216,"_217":289,"_219":220,"_221":222,"_223":290,"_225":226},{"_213":282,"_215":216,"_217":283,"_219":220,"_221":222,"_223":284,"_225":226},{"_213":276,"_215":216,"_217":277,"_219":220,"_221":222,"_223":278,"_225":226},{"_213":270,"_215":216,"_217":271,"_219":220,"_221":222,"_223":272,"_225":226},{"_213":264,"_215":216,"_217":265,"_219":220,"_221":222,"_223":266,"_225":226},{"_213":258,"_215":216,"_217":259,"_219":220,"_221":222,"_223":260,"_225":226},{"_213":252,"_215":216,"_217":253,"_219":220,"_221":222,"_223":254,"_225":226},{"_213":246,"_215":216,"_217":247,"_219":220,"_221":222,"_223":248,"_225":226},{"_213":240,"_215":216,"_217":241,"_219":220,"_221":222,"_223":242,"_225":226},{"_213":234,"_215":216,"_217":235,"_219":220,"_221":222,"_223":236,"_225":226},{"_213":214,"_215":216,"_217":218,"_219":220,"_221":222,"_223":224,"_225":226},"_key","3bdee90e3f70","_type","block","children",[227],"level",1,"listItem","bullet","markDefs",[],"style","normal",{"_213":228,"_215":229,"_230":231,"_232":233},"f4b71992ac55","span","marks",[],"text","Turnkey completion","08f47c89f907",[237],[],{"_213":228,"_215":229,"_230":238,"_232":239},[],"Contemporary architectural façade","74c51be06eeb",[243],[],{"_213":228,"_215":229,"_230":244,"_232":245},[],"Landscaped private outdoor entertaining areas","ae348aefaf57",[249],[],{"_213":228,"_215":229,"_230":250,"_232":251},[],"Energy-efficient construction","1d90f0e02ef9",[255],[],{"_213":228,"_215":229,"_230":256,"_232":257},[],"Double garages","d13dd677f7ff",[261],[],{"_213":228,"_215":229,"_230":262,"_232":263},[],"Luxury bathrooms with premium fixtures and fittings","daaefff2eefe",[267],[],{"_213":228,"_215":229,"_230":268,"_232":269},[],"High ceilings throughout","80f36d404496",[273],[],{"_213":228,"_215":229,"_230":274,"_232":275},[],"Premium engineered timber flooring","fab54a5a384b",[279],[],{"_213":228,"_215":229,"_230":280,"_232":281},[],"Custom joinery and cabinetry","a362ed48e60b",[285],[],{"_213":228,"_215":229,"_230":286,"_232":287},[],"Designer kitchens with stone benchtops","523b3311e88d",[291],[],{"_213":228,"_215":229,"_230":292,"_232":293},[],"Premium custom finishes throughout","e72cf52c997c",[297],[],{"_213":228,"_215":229,"_230":298,"_232":299},[],"Approximately 33 squares each","729854116406",[303],[],{"_213":228,"_215":229,"_230":304,"_232":305},[],"Two architecturally designed side-by-side townhouses","d60ea200e1c9",[310],[],"h3",{"_213":228,"_215":229,"_230":311,"_232":312},[],"Key Features","9bc656999f70",[316],[],{"_213":228,"_215":229,"_230":317,"_232":318},[],"Careful scheduling of deliveries, close coordination with trades and strict quality control enabled the project to progress efficiently despite the site’s logistical constraints. The result is two high-quality custom townhouses that combine timeless architectural design with premium finishes and exceptional craftsmanship.","f9ce65eedf90",[322],[],{"_213":228,"_215":229,"_230":323,"_232":324},[],"Through detailed planning, staged construction sequencing and proactive project management, Siari Build successfully delivered both residences without compromising on quality or workmanship.","2ead7de4e0a6",[328],[],{"_213":228,"_215":229,"_230":329,"_232":330},[],"Our Solution","d45ab49f611a",[334],[],{"_213":228,"_215":229,"_230":335,"_232":336},[],"Building two premium residences simultaneously while maintaining quality, safety and efficiency demanded meticulous project management and strong collaboration between trades, suppliers and consultants.","1f3d96df5d1e",[340],[],{"_213":228,"_215":229,"_230":341,"_232":342},[],"Located on Warrigal Road, one of Melbourne’s busiest arterial roads, this project presented significant logistical and construction challenges. Limited site access, constant traffic, restricted material deliveries and the need to maintain a safe work environment required careful planning and coordination throughout every stage of construction.","461554368f89",[346],[],{"_213":228,"_215":229,"_230":347,"_232":348},[],"The Challenge","27e248223d01",[352],[],{"_213":228,"_215":229,"_230":353,"_232":354},[],"Despite significant industry-wide material price increases during construction, the project was completed to an exceptional standard while maintaining the agreed contract price and construction program.","5ed89afeceb1",[358],[],{"_213":228,"_215":229,"_230":359,"_232":360},[],"The Bentleigh East Residence comprises two architecturally designed side-by-side custom townhouses, each approximately 33 squares, built to a premium specification. Featuring high-end finishes, contemporary architecture and thoughtfully designed floorplans, the development delivers modern family living while maximising the potential of a challenging urban site.","fc05737c13de",[365],[],"h2",{"_213":228,"_215":229,"_230":366,"_232":367},[],"Overview",{"_369":370,"_371":372,"_373":374},"settings",{"_432":433,"_434":435,"_436":437,"_438":439,"_440":113,"_441":442,"_443":-5,"_444":445,"_446":396,"_447":-5,"_448":-5,"_449":396,"_450":451,"_452":453,"_454":455,"_456":457,"_458":-5,"_459":460,"_461":462,"_141":463,"_464":465,"_466":467},"navigation",{"_393":394,"_395":396,"_397":398,"_399":400},"services",[375,376,377,378,379,380],{"_232":391,"_30":392},{"_232":389,"_30":390},{"_232":387,"_30":388},{"_232":385,"_30":386},{"_232":383,"_30":384},{"_232":381,"_30":382},"Extra space for family, guests or rental income - designed and built properly, not bolted on.","Granny Flats","From a single kitchen to a whole-home transformation - old bones, new life.","Renovations","More room without the move. Ground-floor and second-storey extensions that look like they were always there.","Extensions & Additions","Dual occupancies and townhouses that get the most out of your site — and your return.","Multi-Dwelling Developments","Already have plans or an architect? We build to your design with the rigour it deserves.","Bespoke Builds","Architecturally led homes built around how you actually live — not a catalogue floor plan.","Custom Homes","footerMenu",[421,422,423,424,425,426],"headerCtaEnabled",true,"headerMenu",[406,407,408,409],"socialMenu",[401],{"_402":-5,"_403":404,"_161":405},"icon","label","Instagram","https://www.instagram.com/siari_build/",{"_403":-5,"_411":419,"_413":420},{"_403":-5,"_411":417,"_413":418},{"_403":-5,"_411":415,"_413":416},{"_403":410,"_411":412,"_413":414},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_403":-5,"_411":419,"_413":420},{"_403":-5,"_411":417,"_413":418},{"_403":-5,"_411":415,"_413":416},{"_403":-5,"_411":412,"_413":414},{"_403":429,"_411":430,"_413":431},{"_403":-5,"_411":427,"_413":428},"privacy-policy","Privacy Policy","FAQ","faq","Frequently Asked Questions","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapAreaRadius","mapHidePin","mapLocation",{"_215":468,"_155":469,"_470":471,"_472":473},"mapZoom",12,"notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","Siari Build","tagline","Designed to Impress. Built to Last.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed","geopoint",7,"lat",-37.895696,"lng",144.76186]

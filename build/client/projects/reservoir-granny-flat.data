2":146,"_147":203,"_149":204},[],"Open-plan kitchen, living and dining area","2f163dca4d85",[208],[],{"_130":145,"_132":146,"_147":209,"_149":210},[],"Fully self-contained residence","76a353760262",[214],[],{"_130":145,"_132":146,"_147":215,"_149":216},[],"Contemporary architectural design","00a08aa6cba7",[221],[],"h3",{"_130":145,"_132":146,"_147":222,"_149":223},[],"Key Features","63cababd0d50",[227],[],{"_130":145,"_132":146,"_147":228,"_149":229},[],"Siari Build designed and constructed a contemporary granny flat that combines efficient use of space with premium finishes and quality workmanship. Through intelligent planning, modern design principles and attention to detail, the residence delivers comfortable everyday living while adding significant value and flexibility to the property.\nEvery stage of the project was carefully managed to ensure a smooth construction process and an exceptional finished result.","59858cab1358",[233],[],{"_130":145,"_132":146,"_147":234,"_149":235},[],"Our Solution","22d20b18c6ca",[239],[],{"_130":145,"_132":146,"_147":240,"_149":241},[],"The objective was to create a modern, self-contained residence within an existing property while ensuring the new dwelling complemented the main home and maximised the available land. Careful planning was required to optimise privacy, natural light, outdoor living and functionality, all while complying with planning and building regulations.","1a775156cdd0",[245],[],{"_130":145,"_132":146,"_147":246,"_149":247},[],"The Challenge","51125c4b4127",[251],[],{"_130":145,"_132":146,"_147":252,"_149":253},[],"This project demonstrates Siari Build’s ability to deliver practical, high-quality homes that make the most of every square metre while maintaining the same level of craftsmanship found in our larger custom homes.","d93c0484ec62",[257],[],{"_130":145,"_132":146,"_147":258,"_149":259},[],"The Reservoir Granny Flat is a contemporary custom-built secondary residence designed to maximise functionality, comfort and long-term value on an established suburban allotment. Despite its compact footprint, the home offers spacious open-plan living, premium finishes and modern architectural styling, making it ideal for extended family accommodation, guest living or investment purposes.","8686f08fba8d",[264],[],"h2",{"_130":265,"_132":146,"_147":266,"_149":267},"bba31a6db041",[],"Overview",{"_269":270,"_271":272},"settings",{"_309":310,"_311":312,"_313":314,"_315":316,"_317":98,"_318":319,"_320":-5,"_321":322,"_323":276,"_324":-5,"_325":-5,"_326":-5,"_327":328,"_329":330,"_331":-5,"_332":333,"_334":335,"_336":337,"_338":339,"_340":341},"navigation",{"_273":274,"_275":276,"_277":278,"_279":280},"footerMenu",[302,303,304,305,306],"headerCtaEnabled",true,"headerMenu",[287,288,289,290],"socialMenu",[281],{"_282":-5,"_283":284,"_285":286},"icon","label","Instagram","url","https://www.instagram.com/siari_build/",{"_283":-5,"_292":300,"_294":301},{"_283":-5,"_292":298,"_294":299},{"_283":-5,"_292":296,"_294":297},{"_283":291,"_292":293,"_294":295},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_283":-5,"_292":300,"_294":301},{"_283":-5,"_292":298,"_294":299},{"_283":-5,"_292":296,"_294":297},{"_283":-5,"_292":293,"_294":295},{"_283":-5,"_292":307,"_294":308},"privacy-policy","Privacy Policy","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapLocation","mapZoom","notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn
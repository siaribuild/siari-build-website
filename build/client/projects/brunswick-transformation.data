81":182,"_183":316,"_189":317,"_191":192},{"_179":309,"_181":182,"_183":310,"_189":311,"_191":192},{"_179":303,"_181":182,"_183":304,"_189":305,"_191":269},{"_179":297,"_181":182,"_183":298,"_189":299,"_191":192},{"_179":291,"_181":182,"_183":292,"_189":293,"_191":192},{"_179":285,"_181":182,"_183":286,"_189":287,"_191":269},{"_179":279,"_181":182,"_183":280,"_189":281,"_191":192},{"_179":273,"_181":182,"_183":274,"_189":275,"_191":192},{"_179":266,"_181":182,"_183":267,"_189":268,"_191":269},{"_179":260,"_181":182,"_183":261,"_185":186,"_187":188,"_189":262,"_191":192},{"_179":254,"_181":182,"_183":255,"_185":186,"_187":188,"_189":256,"_191":192},{"_179":248,"_181":182,"_183":249,"_185":186,"_187":188,"_189":250,"_191":192},{"_179":242,"_181":182,"_183":243,"_185":186,"_187":188,"_189":244,"_191":192},{"_179":236,"_181":182,"_183":237,"_185":186,"_187":188,"_189":238,"_191":192},{"_179":230,"_181":182,"_183":231,"_185":186,"_187":188,"_189":232,"_191":192},{"_179":224,"_181":182,"_183":225,"_185":186,"_187":188,"_189":226,"_191":192},{"_179":218,"_181":182,"_183":219,"_185":186,"_187":188,"_189":220,"_191":192},{"_179":212,"_181":182,"_183":213,"_185":186,"_187":188,"_189":214,"_191":192},{"_179":206,"_181":182,"_183":207,"_185":186,"_187":188,"_189":208,"_191":192},{"_179":200,"_181":182,"_183":201,"_185":186,"_187":188,"_189":202,"_191":192},{"_179":180,"_181":182,"_183":184,"_185":186,"_187":188,"_189":190,"_191":192},"_key","521517b575e8","_type","block","children",[193],"level",1,"listItem","bullet","markDefs",[],"style","normal",{"_179":194,"_181":195,"_196":197,"_198":199},"0467201d28ce","span","marks",[],"text","High-quality craftsmanship throughout","63f8a2629371",[203],[],{"_179":194,"_181":195,"_196":204,"_198":205},[],"Blending original character with contemporary design","7daedc0bdfdb",[209],[],{"_179":194,"_181":195,"_196":210,"_198":211},[],"Significant increase in property value","48d55f16e3e0",[215],[],{"_179":194,"_181":195,"_196":216,"_198":217},[],"Functional family floorplan","6d1d7ed3cbfb",[221],[],{"_179":194,"_181":195,"_196":222,"_198":223},[],"Modern fixtures and fittings","12e521ebfeb8",[227],[],{"_179":194,"_181":195,"_196":228,"_198":229},[],"New lighting and electrical upgrades","f9835fb6c5a2",[233],[],{"_179":194,"_181":195,"_196":234,"_198":235},[],"Premium flooring throughout","c6c4f30b1a10",[239],[],{"_179":194,"_181":195,"_196":240,"_198":241},[],"Fully renovated bathrooms","10ac91b33cae",[245],[],{"_179":194,"_181":195,"_196":246,"_198":247},[],"Designer kitchen with premium finishes","556c155f8362",[251],[],{"_179":194,"_181":195,"_196":252,"_198":253},[],"Contemporary open-plan living design","0a245955a5fb",[257],[],{"_179":194,"_181":195,"_196":258,"_198":259},[],"Original façade retained and enhanced","331167121285",[263],[],{"_179":194,"_181":195,"_196":264,"_198":265},[],"Complete internal renovation","7c0f50d4a8d3",[270],[],"h3",{"_179":194,"_181":195,"_196":271,"_198":272},[],"Key Features","5249650a320d",[276],[],{"_179":194,"_181":195,"_196":277,"_198":278},[],"Through detailed planning and quality craftsmanship, we delivered a home that feels entirely new while respecting the history of the original residence.","273e073527d7",[282],[],{"_179":194,"_181":195,"_196":283,"_198":284},[],"Siari Build carefully retained the original architectural elements that defined the home’s character while completely transforming the interior to suit modern family living. The renovation included a new open-plan layout, upgraded kitchen and bathrooms, premium finishes, new flooring and contemporary lighting throughout.","9de8450e03bf",[288],[],{"_179":194,"_181":195,"_196":289,"_198":290},[],"Our Solution","4bce58369a89",[294],[],{"_179":194,"_181":195,"_196":295,"_198":296},[],"As with many renovation projects, working within an existing structure required flexibility and problem-solving to ensure the finished result met modern building standards without compromising the home’s original charm.","b70aec7a6448",[300],[],{"_179":194,"_181":195,"_196":301,"_198":302},[],"The objective was to modernise an ageing home without losing its original character. Maintaining the structural integrity of the existing building while redesigning the internal layout, upgrading services and incorporating modern finishes required careful planning and detailed coordination throughout the construction process.","e9e1c760f2de",[306],[],{"_179":194,"_181":195,"_196":307,"_198":308},[],"The Challenge","bc25cff8009a",[312],[],{"_179":194,"_181":195,"_196":313,"_198":314},[],"The project significantly increased the property’s value while delivering a home that feels both contemporary and functional.","91f069301ca9",[318],[],{"_179":194,"_181":195,"_196":319,"_198":320},[],"The Brunswick Renovation involved the complete transformation of a 1970s double-storey brick residence into a contemporary family home while preserving its original character and street presence. By retaining the existing façade and completely reimagining the interior, this renovation successfully blended timeless architecture with modern living.","c37faabe7537",[325],[],"h2",{"_179":194,"_181":195,"_196":326,"_198":327},[],"Overview",{"_329":330,"_331":332},"settings",{"_368":369,"_370":371,"_372":373,"_374":375,"_376":98,"_377":378,"_379":-5,"_380":381,"_382":336,"_383":-5,"_384":-5,"_385":-5,"_386":387,"_388":389,"_390":-5,"_391":392,"_393":394,"_395":396,"_397":398,"_399":400},"navigation",{"_333":334,"_335":336,"_337":338,"_339":340},"footerMenu",[361,362,363,364,365],"headerCtaEnabled",true,"headerMenu",[346,347,348,349],"socialMenu",[341],{"_342":-5,"_343":344,"_121":345},"icon","label","Instagram","https://www.instagram.com/siari_build/",{"_343":-5,"_351":359,"_353":360},{"_343":-5,"_351":357,"_353":358},{"_343":-5,"_351":355,"_353":356},{"_343":350,"_351":352,"_353":354},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_343":-5,"_351":359,"_353":360},{"_343":-5,"_351":357,"_353":358},{"_343":-5,"_351":355,"_353":356},{"_343":-5,"_351":352,"_353":354},{"_343":-5,"_351":366,"_353":367},"privacy-policy","Privacy Policy","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapLocation","mapZoom","notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","siteName","Siari Build","tagline","We don't just build houses. We build the next forty years of your life.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed"]

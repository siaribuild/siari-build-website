177":207,"_179":180,"_181":182,"_183":208,"_185":186},{"_173":200,"_175":176,"_177":201,"_179":180,"_181":182,"_183":202,"_185":186},{"_173":194,"_175":176,"_177":195,"_179":180,"_181":182,"_183":196,"_185":186},{"_173":174,"_175":176,"_177":178,"_179":180,"_181":182,"_183":184,"_185":186},"_key","1568440456bf","_type","block","children",[187],"level",1,"listItem","bullet","markDefs",[],"style","normal",{"_173":188,"_175":189,"_190":191,"_192":193},"e54cc8ba19a7","span","marks",[],"text","Maximised use of a compact urban site","760f108e2ef5",[197],[],{"_173":188,"_175":189,"_190":198,"_192":199},[],"Energy-efficient construction","a00f89e4525c",[203],[],{"_173":188,"_175":189,"_190":204,"_192":205},[],"Luxury bathrooms with designer fixtures","d29b517b5931",[209],[],{"_173":188,"_175":189,"_190":210,"_192":211},[],"High ceilings and expansive glazing","4dc16c01bf0d",[215],[],{"_173":188,"_175":189,"_190":216,"_192":217},[],"Premium natural stone finishes","8e37c2302111",[221],[],{"_173":188,"_175":189,"_190":222,"_192":223},[],"Custom-designed joinery throughout","46f2efb85ac5",[227],[],{"_173":188,"_175":189,"_190":228,"_192":229},[],"Designer kitchen with premium appliances","df89c3404ecf",[233],[],{"_173":188,"_175":189,"_190":234,"_192":235},[],"Open-plan kitchen, living and dining","4a3267b6798d",[239],[],{"_173":188,"_175":189,"_190":240,"_192":241},[],"Premium architectural façade","7f860b5a529a",[245],[],{"_173":188,"_175":189,"_190":246,"_192":247},[],"Architecturally designed contemporary home","5ac407ef52f1",[251],[],{"_173":188,"_175":189,"_190":252,"_192":253},[],"Built on a 300sqm inner-city allotment","7a4121cab82c",[257],[],{"_173":188,"_175":189,"_190":258,"_192":259},[],"Approximately 335sqm (36 Squares) custom residence","1ca9cd236cca",[264],[],"h3",{"_173":188,"_175":189,"_190":265,"_192":266},[],"Key Features","8ba20743643c",[270],[],{"_173":188,"_175":189,"_190":271,"_192":272},[],"Every aspect of the home has been carefully considered to deliver a residence that is both functional and visually striking, demonstrating our commitment to quality and innovation.","9461264a2d82",[276],[],{"_173":188,"_175":189,"_190":277,"_192":278},[],"Siari Build managed the project from planning through to construction, coordinating every stage to ensure a seamless building process. By combining intelligent design, efficient site management and exceptional craftsmanship, the project maximises every square metre of the allotment while creating spacious, light-filled living areas and a premium architectural finish.","069ec55841ed",[282],[],{"_173":188,"_175":189,"_190":283,"_192":284},[],"Our Solution","fee527c28b83",[288],[],{"_173":188,"_175":189,"_190":289,"_192":290},[],"Managing planning approvals, demolition, engineering, protection works and construction sequencing while maintaining safety, quality and efficiency required strong project management and close coordination with consultants, authorities and trades.","81d15e42d8b7",[294],[],{"_173":188,"_175":189,"_190":295,"_192":296},[],"Constructing a luxury custom home within Melbourne’s inner-city environment presented a unique set of challenges. The compact 300sqm site, close proximity to neighbouring properties, restricted access and extensive council requirements demanded meticulous planning before construction could commence.","9ae5de5ebb23",[300],[],{"_173":188,"_175":189,"_190":301,"_192":302},[],"The Challenge","9312f000e9b5",[306],[],{"_173":188,"_175":189,"_190":307,"_192":308},[],"Located in one of Melbourne’s most established suburbs, this project reflects Siari Build’s ability to deliver high-quality custom homes on challenging urban sites where careful planning, precision and attention to detail are essential.","48b27a3a1a57",[312],[],{"_173":188,"_175":189,"_190":313,"_192":314},[],"The Collingwood Residence is a bespoke 36-square architecturally designed custom home currently under construction on a 300sqm inner-city allotment. Designed to maximise space, natural light and modern family living, the residence combines contemporary architecture with premium finishes and exceptional craftsmanship.","ce610f70c49f",[319],[],"h2",{"_173":188,"_175":189,"_190":320,"_192":321},[],"Overview",{"_323":324,"_325":326},"settings",{"_366":367,"_368":369,"_370":371,"_372":373,"_374":101,"_375":376,"_377":-5,"_378":379,"_380":330,"_381":-5,"_382":-5,"_383":330,"_384":385,"_386":387,"_388":389,"_390":391,"_392":-5,"_393":394,"_395":396,"_128":397,"_398":399,"_400":401},"navigation",{"_327":328,"_329":330,"_331":332,"_333":334},"footerMenu",[355,356,357,358,359,360],"headerCtaEnabled",true,"headerMenu",[340,341,342,343],"socialMenu",[335],{"_336":-5,"_337":338,"_138":339},"icon","label","Instagram","https://www.instagram.com/siari_build/",{"_337":-5,"_345":353,"_347":354},{"_337":-5,"_345":351,"_347":352},{"_337":-5,"_345":349,"_347":350},{"_337":344,"_345":346,"_347":348},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_337":-5,"_345":353,"_347":354},{"_337":-5,"_345":351,"_347":352},{"_337":-5,"_345":349,"_347":350},{"_337":-5,"_345":346,"_347":348},{"_337":363,"_345":364,"_347":365},{"_337":-5,"_345":361,"_347":362},"privacy-policy","Privacy Policy","FAQ","faq","Frequently Asked Questions","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapAreaRadius","mapHidePin","mapLocation",{"_175":402,"_403":404,"_405":406,"_407":408},"mapZoom",12,"notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","Siari Build","tagline","We don't just build houses. We build the next forty years of your life.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed","geopoint","alt",7,"lat",-37.895696,"lng",144.76186]

9,"_154":270,"_156":157},{"_144":262,"_146":147,"_148":263,"_154":264,"_156":157},{"_144":256,"_146":147,"_148":257,"_154":258,"_156":157},{"_144":250,"_146":147,"_148":251,"_154":252,"_156":234},{"_144":244,"_146":147,"_148":245,"_154":246,"_156":157},{"_144":238,"_146":147,"_148":239,"_154":240,"_156":157},{"_144":231,"_146":147,"_148":232,"_154":233,"_156":234},{"_144":225,"_146":147,"_148":226,"_150":151,"_152":153,"_154":227,"_156":157},{"_144":219,"_146":147,"_148":220,"_150":151,"_152":153,"_154":221,"_156":157},{"_144":213,"_146":147,"_148":214,"_150":151,"_152":153,"_154":215,"_156":157},{"_144":207,"_146":147,"_148":208,"_150":151,"_152":153,"_154":209,"_156":157},{"_144":201,"_146":147,"_148":202,"_150":151,"_152":153,"_154":203,"_156":157},{"_144":195,"_146":147,"_148":196,"_150":151,"_152":153,"_154":197,"_156":157},{"_144":189,"_146":147,"_148":190,"_150":151,"_152":153,"_154":191,"_156":157},{"_144":183,"_146":147,"_148":184,"_150":151,"_152":153,"_154":185,"_156":157},{"_144":177,"_146":147,"_148":178,"_150":151,"_152":153,"_154":179,"_156":157},{"_144":171,"_146":147,"_148":172,"_150":151,"_152":153,"_154":173,"_156":157},{"_144":165,"_146":147,"_148":166,"_150":151,"_152":153,"_154":167,"_156":157},{"_144":145,"_146":147,"_148":149,"_150":151,"_152":153,"_154":155,"_156":157},"_key","1568440456bf","_type","block","children",[158],"level",1,"listItem","bullet","markDefs",[],"style","normal",{"_144":159,"_146":160,"_161":162,"_163":164},"e54cc8ba19a7","span","marks",[],"text","Maximised use of a compact urban site","760f108e2ef5",[168],[],{"_144":159,"_146":160,"_161":169,"_163":170},[],"Energy-efficient construction","a00f89e4525c",[174],[],{"_144":159,"_146":160,"_161":175,"_163":176},[],"Luxury bathrooms with designer fixtures","d29b517b5931",[180],[],{"_144":159,"_146":160,"_161":181,"_163":182},[],"High ceilings and expansive glazing","4dc16c01bf0d",[186],[],{"_144":159,"_146":160,"_161":187,"_163":188},[],"Premium natural stone finishes","8e37c2302111",[192],[],{"_144":159,"_146":160,"_161":193,"_163":194},[],"Custom-designed joinery throughout","46f2efb85ac5",[198],[],{"_144":159,"_146":160,"_161":199,"_163":200},[],"Designer kitchen with premium appliances","df89c3404ecf",[204],[],{"_144":159,"_146":160,"_161":205,"_163":206},[],"Open-plan kitchen, living and dining","4a3267b6798d",[210],[],{"_144":159,"_146":160,"_161":211,"_163":212},[],"Premium architectural façade","7f860b5a529a",[216],[],{"_144":159,"_146":160,"_161":217,"_163":218},[],"Architecturally designed contemporary home","5ac407ef52f1",[222],[],{"_144":159,"_146":160,"_161":223,"_163":224},[],"Built on a 300sqm inner-city allotment","7a4121cab82c",[228],[],{"_144":159,"_146":160,"_161":229,"_163":230},[],"Approximately 335sqm (36 Squares) custom residence","1ca9cd236cca",[235],[],"h3",{"_144":159,"_146":160,"_161":236,"_163":237},[],"Key Features","8ba20743643c",[241],[],{"_144":159,"_146":160,"_161":242,"_163":243},[],"Every aspect of the home has been carefully considered to deliver a residence that is both functional and visually striking, demonstrating our commitment to quality and innovation.","9461264a2d82",[247],[],{"_144":159,"_146":160,"_161":248,"_163":249},[],"Siari Build managed the project from planning through to construction, coordinating every stage to ensure a seamless building process. By combining intelligent design, efficient site management and exceptional craftsmanship, the project maximises every square metre of the allotment while creating spacious, light-filled living areas and a premium architectural finish.","069ec55841ed",[253],[],{"_144":159,"_146":160,"_161":254,"_163":255},[],"Our Solution","fee527c28b83",[259],[],{"_144":159,"_146":160,"_161":260,"_163":261},[],"Managing planning approvals, demolition, engineering, protection works and construction sequencing while maintaining safety, quality and efficiency required strong project management and close coordination with consultants, authorities and trades.","81d15e42d8b7",[265],[],{"_144":159,"_146":160,"_161":266,"_163":267},[],"Constructing a luxury custom home within Melbourne’s inner-city environment presented a unique set of challenges. The compact 300sqm site, close proximity to neighbouring properties, restricted access and extensive council requirements demanded meticulous planning before construction could commence.","9ae5de5ebb23",[271],[],{"_144":159,"_146":160,"_161":272,"_163":273},[],"The Challenge","9312f000e9b5",[277],[],{"_144":159,"_146":160,"_161":278,"_163":279},[],"Located in one of Melbourne’s most established suburbs, this project reflects Siari Build’s ability to deliver high-quality custom homes on challenging urban sites where careful planning, precision and attention to detail are essential.","48b27a3a1a57",[283],[],{"_144":159,"_146":160,"_161":284,"_163":285},[],"The Collingwood Residence is a bespoke 36-square architecturally designed custom home currently under construction on a 300sqm inner-city allotment. Designed to maximise space, natural light and modern family living, the residence combines contemporary architecture with premium finishes and exceptional craftsmanship.","ce610f70c49f",[290],[],"h2",{"_144":159,"_146":160,"_161":291,"_163":292},[],"Overview",{"_294":295,"_296":297},"settings",{"_333":334,"_335":336,"_337":338,"_339":340,"_341":98,"_342":343,"_344":-5,"_345":346,"_347":301,"_348":-5,"_349":-5,"_350":301,"_351":352,"_353":354,"_355":356,"_357":358,"_359":-5,"_360":361,"_362":363,"_364":365,"_366":367,"_368":369},"navigation",{"_298":299,"_300":301,"_302":303,"_304":305},"footerMenu",[326,327,328,329,330],"headerCtaEnabled",true,"headerMenu",[311,312,313,314],"socialMenu",[306],{"_307":-5,"_308":309,"_109":310},"icon","label","Instagram","https://www.instagram.com/siari_build/",{"_308":-5,"_316":324,"_318":325},{"_308":-5,"_316":322,"_318":323},{"_308":-5,"_316":320,"_318":321},{"_308":315,"_316":317,"_318":319},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_308":-5,"_316":324,"_318":325},{"_308":-5,"_316":322,"_318":323},{"_308":-5,"_316":320,"_318":321},{"_308":-5,"_316":317,"_318":319},{"_308":-5,"_316":331,"_318":332},"privacy-policy","Privacy Policy","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapAreaRadius","mapHidePin","mapLocation",{"_146":370,"_371":372,"_373":374,"_375":376},"mapZoom",12,"notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","siteName","Siari Build","tagline","We don't just build houses. We build the next forty years of your life.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed","geopoint","alt",7,"lat",-37.895696,"lng",144.76186]

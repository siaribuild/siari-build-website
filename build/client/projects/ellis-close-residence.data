37,"_184":185,"_186":253,"_188":189},{"_177":245,"_179":180,"_181":246,"_183":137,"_184":185,"_186":247,"_188":189},{"_177":239,"_179":180,"_181":240,"_183":137,"_184":185,"_186":241,"_188":189},{"_177":233,"_179":180,"_181":234,"_183":137,"_184":185,"_186":235,"_188":189},{"_177":227,"_179":180,"_181":228,"_183":137,"_184":185,"_186":229,"_188":189},{"_177":221,"_179":180,"_181":222,"_183":137,"_184":185,"_186":223,"_188":189},{"_177":215,"_179":180,"_181":216,"_183":137,"_184":185,"_186":217,"_188":189},{"_177":209,"_179":180,"_181":210,"_183":137,"_184":185,"_186":211,"_188":189},{"_177":203,"_179":180,"_181":204,"_183":137,"_184":185,"_186":205,"_188":189},{"_177":197,"_179":180,"_181":198,"_183":137,"_184":185,"_186":199,"_188":189},{"_177":178,"_179":180,"_181":182,"_183":137,"_184":185,"_186":187,"_188":189},"_key","0a31b3f0304f","_type","block","children",[190],"level","listItem","bullet","markDefs",[],"style","normal",{"_177":191,"_179":192,"_193":194,"_195":196},"bbd249cc1239","span","marks",[],"text","Energy-efficient construction with premium insulation","57c7e5bfc0b4",[200],[],{"_177":191,"_179":192,"_193":201,"_195":202},[],"Seamless indoor-outdoor entertaining spaces","35d9dac974a0",[206],[],{"_177":191,"_179":192,"_193":207,"_195":208},[],"Engineered timber flooring","a9a106c08ac1",[212],[],{"_177":191,"_179":192,"_193":213,"_195":214},[],"Custom-designed joinery throughout","18891aaa592b",[218],[],{"_177":191,"_179":192,"_193":219,"_195":220},[],"Designer kitchen with premium appliances and butler’s pantry","a06c9df3aff7",[224],[],{"_177":191,"_179":192,"_193":225,"_195":226},[],"Feature fireplace with full-height marble surround","1f812dc1a444",[230],[],{"_177":191,"_179":192,"_193":231,"_195":232},[],"Premium natural stone throughout","7605620693ef",[236],[],{"_177":191,"_179":192,"_193":237,"_195":238},[],"Floor-to-ceiling architectural glazing","d4979ebcb8da",[242],[],{"_177":191,"_179":192,"_193":243,"_195":244},[],"Grand double-height entrance with feature void","646f4e87cc4c",[248],[],{"_177":191,"_179":192,"_193":249,"_195":250},[],"3-metre ceilings throughout","7562a0488efd",[254],[],{"_177":191,"_179":192,"_193":255,"_195":256},[],"Golf course frontage with uninterrupted views","0dd95b0424b3",[260],[],{"_177":191,"_179":192,"_193":261,"_195":262},[],"Dedicated home theatre","171c0b3c54ea",[266],[],{"_177":191,"_179":192,"_193":267,"_195":268},[],"Architectural spiral staircase","fa6e3ce20582",[272],[],{"_177":191,"_179":192,"_193":273,"_195":274},[],"Resort-style swimming pool and integrated spa","3954fb470a93",[278],[],{"_177":191,"_179":192,"_193":279,"_195":280},[],"Approximately 560sqm luxury custom residence","fbab83152d9e",[285],[],"h3",{"_177":191,"_179":192,"_193":286,"_195":287},[],"Key Features","80c87fa69f03",[291],[],{"_177":191,"_179":192,"_193":292,"_195":293},[],"By managing every stage of the project—from planning and approvals through to construction and final handover—we delivered a residence that exceeds expectations in both design and quality.","1b6ab343c2f3",[297],[],{"_177":191,"_179":192,"_193":298,"_195":299},[],"The home features expansive floor-to-ceiling glazing to capture natural light and golf course views, premium natural stone throughout, custom-designed joinery and carefully selected finishes that create a warm yet luxurious atmosphere. A feature spiral staircase, resort-style swimming pool and spa, dedicated home theatre and thoughtfully designed entertaining spaces ensure the home is equally suited to everyday family living and entertaining.","669bc94a5e64",[303],[],{"_177":191,"_179":192,"_193":304,"_195":305},[],"Working closely with the client from concept through to completion, Siari Build delivered a bespoke residence that combines sophisticated architectural design with exceptional craftsmanship.","85ac23bcc30d",[309],[],{"_177":191,"_179":192,"_193":310,"_195":311},[],"Our Solution","1b0b2ab6b1c7",[315],[],{"_177":191,"_179":192,"_193":316,"_195":317},[],"Delivering these design aspirations required meticulous planning, precise construction techniques and uncompromising attention to detail across every stage of the project.","ec82d360fbc4",[321],[],{"_177":191,"_179":192,"_193":322,"_195":323},[],"The vision was to create a home that maximised its unique golf course position while delivering a luxurious yet highly functional family residence. The brief called for generous open-plan living, abundant natural light, seamless indoor-outdoor integration and premium architectural detailing throughout, all while maintaining privacy, energy efficiency and timeless appeal.","bb5c14481adb",[327],[],{"_177":191,"_179":192,"_193":328,"_195":329},[],"The Challenge","e9dfcc8f56d9",[333],[],{"_177":191,"_179":192,"_193":334,"_195":335},[],"Featuring expansive glazing, soaring ceilings, premium natural stone, a resort-style swimming pool and spa, and a striking architectural spiral staircase, every element has been carefully considered to create a timeless home that embraces luxury, comfort and indoor-outdoor living.","bd2037495198",[339],[],{"_177":191,"_179":192,"_193":340,"_195":341},[],"The Ellis Close Residence is a luxury custom home designed to showcase contemporary architecture, exceptional craftsmanship and refined family living. Situated within the prestigious Sanctuary Lakes estate overlooking the golf course, this approximately 60sq residence seamlessly blends elegant design with everyday functionality.","de8429d97b62",[346],[],"h2",{"_177":191,"_179":192,"_193":347,"_195":348},[],"Overview",{"_350":351,"_352":353},"settings",{"_389":390,"_391":392,"_393":394,"_395":396,"_397":104,"_398":399,"_400":-5,"_401":402,"_403":357,"_404":-5,"_405":-5,"_406":357,"_407":408,"_409":410,"_411":412,"_413":414,"_415":-5,"_416":417,"_418":419,"_123":420,"_421":422,"_423":424},"navigation",{"_354":355,"_356":357,"_358":359,"_360":361},"footerMenu",[382,383,384,385,386],"headerCtaEnabled",true,"headerMenu",[367,368,369,370],"socialMenu",[362],{"_363":-5,"_364":365,"_135":366},"icon","label","Instagram","https://www.instagram.com/siari_build/",{"_364":-5,"_372":380,"_374":381},{"_364":-5,"_372":378,"_374":379},{"_364":-5,"_372":376,"_374":377},{"_364":371,"_372":373,"_374":375},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_364":-5,"_372":380,"_374":381},{"_364":-5,"_372":378,"_374":379},{"_364":-5,"_372":376,"_374":377},{"_364":-5,"_372":373,"_374":375},{"_364":-5,"_372":387,"_374":388},"privacy-policy","Privacy Policy","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapAreaRadius","mapHidePin","mapLocation",{"_179":425,"_426":427,"_428":429,"_430":431},"mapZoom",12,"notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","Siari Build","tagline","We don't just build houses. We build the next forty years of your life.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed","geopoint","alt",7,"lat",-37.895696,"lng",144.76186]

3,"_203":204,"_205":264,"_207":159,"_208":209,"_210":265,"_212":213},{"_201":257,"_203":204,"_205":258,"_207":159,"_208":209,"_210":259,"_212":213},{"_201":251,"_203":204,"_205":252,"_207":159,"_208":209,"_210":253,"_212":213},{"_201":245,"_203":204,"_205":246,"_207":159,"_208":209,"_210":247,"_212":213},{"_201":239,"_203":204,"_205":240,"_207":159,"_208":209,"_210":241,"_212":213},{"_201":233,"_203":204,"_205":234,"_207":159,"_208":209,"_210":235,"_212":213},{"_201":227,"_203":204,"_205":228,"_207":159,"_208":209,"_210":229,"_212":213},{"_201":221,"_203":204,"_205":222,"_207":159,"_208":209,"_210":223,"_212":213},{"_201":202,"_203":204,"_205":206,"_207":159,"_208":209,"_210":211,"_212":213},"_key","0a31b3f0304f","_type","block","children",[214],"level","listItem","bullet","markDefs",[],"style","normal",{"_201":215,"_203":216,"_217":218,"_219":220},"bbd249cc1239","span","marks",[],"text","Energy-efficient construction with premium insulation","57c7e5bfc0b4",[224],[],{"_201":215,"_203":216,"_217":225,"_219":226},[],"Seamless indoor-outdoor entertaining spaces","35d9dac974a0",[230],[],{"_201":215,"_203":216,"_217":231,"_219":232},[],"Engineered timber flooring","a9a106c08ac1",[236],[],{"_201":215,"_203":216,"_217":237,"_219":238},[],"Custom-designed joinery throughout","18891aaa592b",[242],[],{"_201":215,"_203":216,"_217":243,"_219":244},[],"Designer kitchen with premium appliances and butler’s pantry","a06c9df3aff7",[248],[],{"_201":215,"_203":216,"_217":249,"_219":250},[],"Feature fireplace with full-height marble surround","1f812dc1a444",[254],[],{"_201":215,"_203":216,"_217":255,"_219":256},[],"Premium natural stone throughout","7605620693ef",[260],[],{"_201":215,"_203":216,"_217":261,"_219":262},[],"Floor-to-ceiling architectural glazing","d4979ebcb8da",[266],[],{"_201":215,"_203":216,"_217":267,"_219":268},[],"Grand double-height entrance with feature void","646f4e87cc4c",[272],[],{"_201":215,"_203":216,"_217":273,"_219":274},[],"3-metre ceilings throughout","7562a0488efd",[278],[],{"_201":215,"_203":216,"_217":279,"_219":280},[],"Golf course frontage with uninterrupted views","0dd95b0424b3",[284],[],{"_201":215,"_203":216,"_217":285,"_219":286},[],"Dedicated home theatre","171c0b3c54ea",[290],[],{"_201":215,"_203":216,"_217":291,"_219":292},[],"Architectural spiral staircase","fa6e3ce20582",[296],[],{"_201":215,"_203":216,"_217":297,"_219":298},[],"Resort-style swimming pool and integrated spa","3954fb470a93",[302],[],{"_201":215,"_203":216,"_217":303,"_219":304},[],"Approximately 560sqm luxury custom residence","fbab83152d9e",[309],[],"h3",{"_201":215,"_203":216,"_217":310,"_219":311},[],"Key Features","80c87fa69f03",[315],[],{"_201":215,"_203":216,"_217":316,"_219":317},[],"By managing every stage of the project—from planning and approvals through to construction and final handover—we delivered a residence that exceeds expectations in both design and quality.","1b6ab343c2f3",[321],[],{"_201":215,"_203":216,"_217":322,"_219":323},[],"The home features expansive floor-to-ceiling glazing to capture natural light and golf course views, premium natural stone throughout, custom-designed joinery and carefully selected finishes that create a warm yet luxurious atmosphere. A feature spiral staircase, resort-style swimming pool and spa, dedicated home theatre and thoughtfully designed entertaining spaces ensure the home is equally suited to everyday family living and entertaining.","669bc94a5e64",[327],[],{"_201":215,"_203":216,"_217":328,"_219":329},[],"Working closely with the client from concept through to completion, Siari Build delivered a bespoke residence that combines sophisticated architectural design with exceptional craftsmanship.","85ac23bcc30d",[333],[],{"_201":215,"_203":216,"_217":334,"_219":335},[],"Our Solution","1b0b2ab6b1c7",[339],[],{"_201":215,"_203":216,"_217":340,"_219":341},[],"Delivering these design aspirations required meticulous planning, precise construction techniques and uncompromising attention to detail across every stage of the project.","ec82d360fbc4",[345],[],{"_201":215,"_203":216,"_217":346,"_219":347},[],"The vision was to create a home that maximised its unique golf course position while delivering a luxurious yet highly functional family residence. The brief called for generous open-plan living, abundant natural light, seamless indoor-outdoor integration and premium architectural detailing throughout, all while maintaining privacy, energy efficiency and timeless appeal.","bb5c14481adb",[351],[],{"_201":215,"_203":216,"_217":352,"_219":353},[],"The Challenge","e9dfcc8f56d9",[357],[],{"_201":215,"_203":216,"_217":358,"_219":359},[],"Featuring expansive glazing, soaring ceilings, premium natural stone, a resort-style swimming pool and spa, and a striking architectural spiral staircase, every element has been carefully considered to create a timeless home that embraces luxury, comfort and indoor-outdoor living.","bd2037495198",[363],[],{"_201":215,"_203":216,"_217":364,"_219":365},[],"The Ellis Close Residence is a luxury custom home designed to showcase contemporary architecture, exceptional craftsmanship and refined family living. Situated within the prestigious Sanctuary Lakes estate overlooking the golf course, this approximately 60sq residence seamlessly blends elegant design with everyday functionality.","de8429d97b62",[370],[],"h2",{"_201":215,"_203":216,"_217":371,"_219":372},[],"Overview",{"_374":375,"_376":377,"_378":379},"settings",{"_438":439,"_440":441,"_442":443,"_444":445,"_446":114,"_447":448,"_449":-5,"_450":451,"_452":401,"_453":-5,"_454":-5,"_455":401,"_456":457,"_458":459,"_460":461,"_462":463,"_464":-5,"_465":466,"_467":468,"_142":469,"_470":471,"_472":473},"navigation",{"_398":399,"_400":401,"_402":403,"_404":405},"services",[380,381,382,383,384,385],{"_219":396,"_30":397},{"_219":394,"_30":395},{"_219":392,"_30":393},{"_219":390,"_30":391},{"_219":388,"_30":389},{"_219":386,"_30":387},"Extra space for family, guests or rental income - designed and built properly, not bolted on.","Granny Flats","From a single kitchen to a whole-home transformation - old bones, new life.","Renovations","More room without the move. Ground-floor and second-storey extensions that look like they were always there.","Extensions & Additions","Dual occupancies and townhouses that get the most out of your site — and your return.","Multi-Dwelling Developments","Already have plans or an architect? We build to your design with the rigour it deserves.","Bespoke Builds","Architecturally led homes built around how you actually live — not a catalogue floor plan.","Custom Homes","footerMenu",[427,428,429,430,431,432],"headerCtaEnabled",true,"headerMenu",[412,413,414,415],"socialMenu",[406],{"_407":-5,"_408":409,"_410":-5,"_156":411},"icon","label","Instagram","showInMenu","https://www.instagram.com/siari_build/",{"_408":-5,"_417":425,"_419":426},{"_408":-5,"_417":423,"_419":424},{"_408":-5,"_417":421,"_419":422},{"_408":416,"_417":418,"_419":420},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_408":-5,"_417":425,"_419":426},{"_408":-5,"_417":423,"_419":424},{"_408":-5,"_417":421,"_419":422},{"_408":-5,"_417":418,"_419":420},{"_408":435,"_417":436,"_419":437},{"_408":-5,"_417":433,"_419":434},"privacy-policy","Privacy Policy","FAQ","faq","Frequently Asked Questions","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapAreaRadius","mapHidePin","mapLocation",{"_203":474,"_149":475,"_476":477,"_478":479},"mapZoom",12,"notFoundButtonLabel","Back to Home",
224":225,"_226":227,"_228":229},"_key","9ffcd6ec3c35","_type","block","children",[230],"level",1,"listItem","bullet","markDefs",[],"style","normal",{"_216":231,"_218":232,"_233":234,"_235":236},"3ca65d6deab5","span","marks",[],"text","Energy-efficient construction","0a5576c26fb6",[240],[],{"_216":231,"_218":232,"_233":241,"_235":242},[],"Landscaped front and rear yards","9709225d069b",[246],[],{"_216":231,"_218":232,"_233":247,"_235":248},[],"Double garage","4a9436cefb09",[252],[],{"_216":231,"_218":232,"_233":253,"_235":254},[],"Open-plan kitchen, living and dining","53e71389d3bc",[258],[],{"_216":231,"_218":232,"_233":259,"_235":260},[],"Premium bathrooms with quality fixtures","a56feefc4804",[264],[],{"_216":231,"_218":232,"_233":265,"_235":266},[],"Tiled flooring throughout living areas","84375ecf30ce",[270],[],{"_216":231,"_218":232,"_233":271,"_235":272},[],"Designer kitchen with stone benchtops","2354d8b33592",[276],[],{"_216":231,"_218":232,"_233":277,"_235":278},[],"Refrigerated heating and cooling","89cc6c9d9f60",[282],[],{"_216":231,"_218":232,"_233":283,"_235":284},[],"Contemporary architectural façade","a98313c1dea2",[288],[],{"_216":231,"_218":232,"_233":289,"_235":290},[],"Feature cathedral ceiling","1305b6c70db4",[294],[],{"_216":231,"_218":232,"_233":295,"_235":296},[],"Completed in just 3 months","e78f3fe8b087",[300],[],{"_216":231,"_218":232,"_233":301,"_235":302},[],"Built on a compact 240sqm allotment","86cd1d0f95a9",[306],[],{"_216":231,"_218":232,"_233":307,"_235":308},[],"Approximately 205sqm (22 Squares) custom residence","ff4b3e2b5912",[313],[],"h3",{"_216":231,"_218":232,"_233":314,"_235":315},[],"Key Features","782d0c018f67",[319],[],{"_216":231,"_218":232,"_233":320,"_235":321},[],"Through intelligent design, efficient project management and close coordination with trades, Siari Build successfully delivered a spacious and functional custom home in just three months. Open-plan living, quality materials and carefully selected finishes create a modern residence that offers exceptional value while exceeding the client’s expectations.","a3c6f6928eef",[325],[],{"_216":231,"_218":232,"_233":326,"_235":327},[],"Our Solution","a0f37d40bcae",[331],[],{"_216":231,"_218":232,"_233":332,"_235":333},[],"Designing a comfortable family home on a compact 240sqm block required careful planning to maximise internal living space while maintaining a practical layout, natural light and street appeal. The objective was to create a home that felt significantly larger than its footprint while delivering premium finishes within an efficient construction timeframe.","18576792e97c",[337],[],{"_216":231,"_218":232,"_233":338,"_235":339},[],"The Challenge","46168750c9d6",[343],[],{"_216":231,"_218":232,"_233":344,"_235":345},[],"Completed in just three months, the project demonstrates Siari Build’s ability to deliver high-quality homes efficiently without compromising craftsmanship or attention to detail.","a1e241a503c7",[349],[],{"_216":231,"_218":232,"_233":350,"_235":351},[],"The Tarneit Cathedral Residence is a contemporary custom home designed to maximise space, natural light and functionality on a compact 240sqm allotment. Despite the site’s size, this 22-square residence delivers a spacious and modern family environment through clever design, quality finishes and efficient use of every square metre.","a3c9646c59f8",[356],[],"h2",{"_216":231,"_218":232,"_233":357,"_235":358},[],"Overview",{"_360":361,"_362":363,"_364":365,"_366":367},"settings",{"_426":427,"_366":-5,"_428":429,"_430":431,"_432":433,"_434":-5,"_435":113,"_436":437,"_438":-5,"_439":440,"_441":389,"_442":-5,"_443":-5,"_444":389,"_445":446,"_447":448,"_449":450,"_451":452,"_453":-5,"_454":455,"_456":457,"_140":458,"_459":460,"_461":462},"navigation",{"_386":387,"_388":389,"_390":391,"_392":393},"services",[368,369,370,371,372,373],"businessPhoto","https://cdn.sanity.io/images/f0yvhrzy/production/650dd2357c41a87e224539f92b3bd25147c59175-3500x2333.jpg",{"_235":384,"_30":385},{"_235":382,"_30":383},{"_235":380,"_30":381},{"_235":378,"_30":379},{"_235":376,"_30":377},{"_235":374,"_30":375},"Extra space for family, guests or rental income - designed and built properly, not bolted on.","Granny Flats","From a single kitchen to a whole-home transformation - old bones, new life.","Renovations","More room without the move. Ground-floor and second-storey extensions that look like they were always there.","Extensions & Additions","Dual occupancies and townhouses that get the most out of your site — and your return.","Multi-Dwelling Developments","Already have plans or an architect? We build to your design with the rigour it deserves.","Bespoke Builds","Architecturally led homes built around how you actually live — not a catalogue floor plan.","Custom Homes","footerMenu",[415,416,417,418,419,420],"headerCtaEnabled",true,"headerMenu",[400,401,402,403],"socialMenu",[394],{"_395":-5,"_396":-5,"_397":398,"_160":399},"hideFromMenu","icon","label","Instagram","https://www.instagram.com/siari_build/",{"_397":-5,"_405":413,"_407":414},{"_397":-5,"_405":411,"_407":412},{"_397":-5,"_405":409,"_407":410},{"_397":404,"_405":406,"_407":408},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_397":-5,"_405":413,"_407":414},{"_397":-5,"_405":411,"_407":412},{"_397":-5,"_405":409,"_407":410},{"_397":-5,"_405":406,"_407":408},{"_397":423,"_405":424,"_407":425},{"_397":-5,"_405":421,"_407":422},"privacy-policy","Privacy Policy","FAQ","faq","Frequently Asked Questions","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","logo","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapAreaRadius","mapHidePin","mapLocation",{"_218":463,"_153":464,"_465":466,"_467":468},"mapZoom",12,"notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","Siari Build","tagline","Designed to Impress. Built to Last.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed","geopoint",7,"lat",-37.895696,"lng",144.76186]

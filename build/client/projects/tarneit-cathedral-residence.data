[225],[],{"_195":210,"_197":211,"_212":226,"_214":227},[],"Double garage","4a9436cefb09",[231],[],{"_195":210,"_197":211,"_212":232,"_214":233},[],"Open-plan kitchen, living and dining","53e71389d3bc",[237],[],{"_195":210,"_197":211,"_212":238,"_214":239},[],"Premium bathrooms with quality fixtures","a56feefc4804",[243],[],{"_195":210,"_197":211,"_212":244,"_214":245},[],"Tiled flooring throughout living areas","84375ecf30ce",[249],[],{"_195":210,"_197":211,"_212":250,"_214":251},[],"Designer kitchen with stone benchtops","2354d8b33592",[255],[],{"_195":210,"_197":211,"_212":256,"_214":257},[],"Refrigerated heating and cooling","89cc6c9d9f60",[261],[],{"_195":210,"_197":211,"_212":262,"_214":263},[],"Contemporary architectural façade","a98313c1dea2",[267],[],{"_195":210,"_197":211,"_212":268,"_214":269},[],"Feature cathedral ceiling","1305b6c70db4",[273],[],{"_195":210,"_197":211,"_212":274,"_214":275},[],"Completed in just 3 months","e78f3fe8b087",[279],[],{"_195":210,"_197":211,"_212":280,"_214":281},[],"Built on a compact 240sqm allotment","86cd1d0f95a9",[285],[],{"_195":210,"_197":211,"_212":286,"_214":287},[],"Approximately 205sqm (22 Squares) custom residence","ff4b3e2b5912",[292],[],"h3",{"_195":210,"_197":211,"_212":293,"_214":294},[],"Key Features","782d0c018f67",[298],[],{"_195":210,"_197":211,"_212":299,"_214":300},[],"Through intelligent design, efficient project management and close coordination with trades, Siari Build successfully delivered a spacious and functional custom home in just three months. Open-plan living, quality materials and carefully selected finishes create a modern residence that offers exceptional value while exceeding the client’s expectations.","a3c6f6928eef",[304],[],{"_195":210,"_197":211,"_212":305,"_214":306},[],"Our Solution","a0f37d40bcae",[310],[],{"_195":210,"_197":211,"_212":311,"_214":312},[],"Designing a comfortable family home on a compact 240sqm block required careful planning to maximise internal living space while maintaining a practical layout, natural light and street appeal. The objective was to create a home that felt significantly larger than its footprint while delivering premium finishes within an efficient construction timeframe.","18576792e97c",[316],[],{"_195":210,"_197":211,"_212":317,"_214":318},[],"The Challenge","46168750c9d6",[322],[],{"_195":210,"_197":211,"_212":323,"_214":324},[],"Completed in just three months, the project demonstrates Siari Build’s ability to deliver high-quality homes efficiently without compromising craftsmanship or attention to detail.","a1e241a503c7",[328],[],{"_195":210,"_197":211,"_212":329,"_214":330},[],"The Tarneit Cathedral Residence is a contemporary custom home designed to maximise space, natural light and functionality on a compact 240sqm allotment. Despite the site’s size, this 22-square residence delivers a spacious and modern family environment through clever design, quality finishes and efficient use of every square metre.","a3c9646c59f8",[335],[],"h2",{"_195":210,"_197":211,"_212":336,"_214":337},[],"Overview",{"_339":340,"_341":342},"settings",{"_382":383,"_384":385,"_386":387,"_388":389,"_390":103,"_391":392,"_393":-5,"_394":395,"_396":346,"_397":-5,"_398":-5,"_399":346,"_400":401,"_402":403,"_404":405,"_406":407,"_408":-5,"_409":410,"_411":412,"_130":413,"_414":415,"_416":417},"navigation",{"_343":344,"_345":346,"_347":348,"_349":350},"footerMenu",[371,372,373,374,375,376],"headerCtaEnabled",true,"headerMenu",[356,357,358,359],"socialMenu",[351],{"_352":-5,"_353":354,"_148":355},"icon","label","Instagram","https://www.instagram.com/siari_build/",{"_353":-5,"_361":369,"_363":370},{"_353":-5,"_361":367,"_363":368},{"_353":-5,"_361":365,"_363":366},{"_353":360,"_361":362,"_363":364},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_353":-5,"_361":369,"_363":370},{"_353":-5,"_361":367,"_363":368},{"_353":-5,"_361":365,"_363":366},{"_353":-5,"_361":362,"_363
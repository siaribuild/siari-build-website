ec3c35","_type","block","children",[163],"level",1,"listItem","bullet","markDefs",[],"style","normal",{"_149":164,"_151":165,"_166":167,"_168":169},"3ca65d6deab5","span","marks",[],"text","Energy-efficient construction","0a5576c26fb6",[173],[],{"_149":164,"_151":165,"_166":174,"_168":175},[],"Landscaped front and rear yards","9709225d069b",[179],[],{"_149":164,"_151":165,"_166":180,"_168":181},[],"Double garage","4a9436cefb09",[185],[],{"_149":164,"_151":165,"_166":186,"_168":187},[],"Open-plan kitchen, living and dining","53e71389d3bc",[191],[],{"_149":164,"_151":165,"_166":192,"_168":193},[],"Premium bathrooms with quality fixtures","a56feefc4804",[197],[],{"_149":164,"_151":165,"_166":198,"_168":199},[],"Tiled flooring throughout living areas","84375ecf30ce",[203],[],{"_149":164,"_151":165,"_166":204,"_168":205},[],"Designer kitchen with stone benchtops","2354d8b33592",[209],[],{"_149":164,"_151":165,"_166":210,"_168":211},[],"Refrigerated heating and cooling","89cc6c9d9f60",[215],[],{"_149":164,"_151":165,"_166":216,"_168":217},[],"Contemporary architectural façade","a98313c1dea2",[221],[],{"_149":164,"_151":165,"_166":222,"_168":223},[],"Feature cathedral ceiling","1305b6c70db4",[227],[],{"_149":164,"_151":165,"_166":228,"_168":229},[],"Completed in just 3 months","e78f3fe8b087",[233],[],{"_149":164,"_151":165,"_166":234,"_168":235},[],"Built on a compact 240sqm allotment","86cd1d0f95a9",[239],[],{"_149":164,"_151":165,"_166":240,"_168":241},[],"Approximately 205sqm (22 Squares) custom residence","ff4b3e2b5912",[246],[],"h3",{"_149":164,"_151":165,"_166":247,"_168":248},[],"Key Features","782d0c018f67",[252],[],{"_149":164,"_151":165,"_166":253,"_168":254},[],"Through intelligent design, efficient project management and close coordination with trades, Siari Build successfully delivered a spacious and functional custom home in just three months. Open-plan living, quality materials and carefully selected finishes create a modern residence that offers exceptional value while exceeding the client’s expectations.","a3c6f6928eef",[258],[],{"_149":164,"_151":165,"_166":259,"_168":260},[],"Our Solution","a0f37d40bcae",[264],[],{"_149":164,"_151":165,"_166":265,"_168":266},[],"Designing a comfortable family home on a compact 240sqm block required careful planning to maximise internal living space while maintaining a practical layout, natural light and street appeal. The objective was to create a home that felt significantly larger than its footprint while delivering premium finishes within an efficient construction timeframe.","18576792e97c",[270],[],{"_149":164,"_151":165,"_166":271,"_168":272},[],"The Challenge","46168750c9d6",[276],[],{"_149":164,"_151":165,"_166":277,"_168":278},[],"Completed in just three months, the project demonstrates Siari Build’s ability to deliver high-quality homes efficiently without compromising craftsmanship or attention to detail.","a1e241a503c7",[282],[],{"_149":164,"_151":165,"_166":283,"_168":284},[],"The Tarneit Cathedral Residence is a contemporary custom home designed to maximise space, natural light and functionality on a compact 240sqm allotment. Despite the site’s size, this 22-square residence delivers a spacious and modern family environment through clever design, quality finishes and efficient use of every square metre.","a3c9646c59f8",[289],[],"h2",{"_149":164,"_151":165,"_166":290,"_168":291},[],"Overview",{"_293":294,"_295":296},"settings",{"_338":339,"_340":341,"_342":343,"_344":345,"_346":300,"_347":348,"_349":-5,"_350":351,"_352":300,"_353":-5,"_354":-5,"_355":-5,"_356":357,"_358":359,"_360":-5,"_361":362,"_363":364,"_365":366,"_367":368,"_369":370},"navigation",{"_297":298,"_299":300,"_301":302,"_303":304},"footerMenu",[331,332,333,334,335],"headerCtaEnabled",true,"headerMenu",[316,317,318,319],"socialMenu",[305,306,307],{"_308":-5,"_309":314,"_102":315},{"_308":-5,"_309":312,"_102":313},{"_308":-5,"_309":310,"_102":311},"icon","label","Hauzz","http://houzz.com","Instagram","http://insta.com","Facebook","http:\\\\facebook.com",{"_309":-5,"_321":329,"_323":330},{"_309":-5,"_321":327,"_323":328},{"_309":-5,"_321":325,"_323":326},{"_309":320,"_321":322,"_323":324},"Start Your Project","pageSlug","contact","pageTitle","Contact","projects","Projects","about","About","home","Home",{"_309":-5,"_321":329,"_323":330},{"_309":-5,"_321":327,"_323":328},{"_309":-5,"_321":325,"_323":326},{"_309":-5,"_321":322,"_323":324},{"_309":-5,"_321":336,"_323":337},"privacy-policy","Privacy Policy","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapLocation","mapZoom","notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","siteName","Siari Build","tagline","We don't just build houses. We build the next forty years of your life.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed"]

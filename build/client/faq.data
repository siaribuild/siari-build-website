[{"_1":2,"_3":4},"root",{"_5":151},"routes/page",{"_5":6},"data",{"_7":8,"_9":10},"page",{"_15":16,"_17":18,"_19":20,"_21":22},"blockData",{"_11":-5,"_12":-5,"_13":-5,"_14":-5},"featuredProjects","projects","categories","allCategories","sections",[33,34,35,36,37,38,39],"seo",{"_23":24,"_25":-5,"_26":27,"_28":29,"_30":-5,"_31":-5,"_32":-5},"slug","faq","title","Frequently Asked Questions","metaDescription","Answers to the questions we hear most often about building with SIARI Build — from first consultation and planning through pricing, contracts, construction, and aftercare.","metaImage","metaTitle","Frequently Asked Questions | SIARI Build","nofollowAttributes",false,"openGraph","seoKeywords","twitter",{"_40":144,"_42":145,"_44":146,"_45":-5,"_46":-5,"_48":-5,"_50":-5,"_52":-5,"_53":-5,"_54":-5,"_55":-5,"_56":-5,"_57":147,"_58":-5,"_59":148,"_61":149,"_62":-5,"_63":-5,"_64":-5,"_65":-5,"_66":-5,"_67":-5,"_68":-5,"_69":-5,"_70":-5,"_71":-5,"_72":150,"_73":-5,"_74":-5,"_75":-5,"_21":-5},{"_40":132,"_42":84,"_44":-5,"_45":-5,"_46":-5,"_48":-5,"_50":-5,"_52":-5,"_53":-5,"_54":-5,"_55":-5,"_56":-5,"_57":-5,"_58":-5,"_59":-5,"_61":-5,"_62":-5,"_63":-5,"_64":-5,"_65":-5,"_66":133,"_67":-5,"_68":-5,"_69":-5,"_70":-5,"_71":-5,"_72":-5,"_73":-5,"_74":-5,"_75":86,"_21":134},{"_40":120,"_42":84,"_44":-5,"_45":-5,"_46":-5,"_48":-5,"_50":-5,"_52":-5,"_53":-5,"_54":-5,"_55":-5,"_56":-5,"_57":-5,"_58":-5,"_59":-5,"_61":-5,"_62":-5,"_63":-5,"_64":-5,"_65":-5,"_66":121,"_67":-5,"_68":-5,"_69":-5,"_70":-5,"_71":-5,"_72":-5,"_73":-5,"_74":-5,"_75":86,"_21":122},{"_40":108,"_42":84,"_44":-5,"_45":-5,"_46":-5,"_48":-5,"_50":-5,"_52":-5,"_53":-5,"_54":-5,"_55":-5,"_56":-5,"_57":-5,"_58":-5,"_59":-5,"_61":-5,"_62":-5,"_63":-5,"_64":-5,"_65":-5,"_66":109,"_67":-5,"_68":-5,"_69":-5,"_70":-5,"_71":-5,"_72":-5,"_73":-5,"_74":-5,"_75":86,"_21":110},{"_40":96,"_42":84,"_44":-5,"_45":-5,"_46":-5,"_48":-5,"_50":-5,"_52":-5,"_53":-5,"_54":-5,"_55":-5,"_56":-5,"_57":-5,"_58":-5,"_59":-5,"_61":-5,"_62":-5,"_63":-5,"_64":-5,"_65":-5,"_66":97,"_67":-5,"_68":-5,"_69":-5,"_70":-5,"_71":-5,"_72":-5,"_73":-5,"_74":-5,"_75":86,"_21":98},{"_40":83,"_42":84,"_44":-5,"_45":-5,"_46":-5,"_48":-5,"_50":-5,"_52":-5,"_53":-5,"_54":-5,"_55":-5,"_56":-5,"_57":-5,"_58":-5,"_59":-5,"_61":-5,"_62":-5,"_63":-5,"_64":-5,"_65":-5,"_66":85,"_67":-5,"_68":-5,"_69":-5,"_70":-5,"_71":-5,"_72":-5,"_73":-5,"_74":-5,"_75":86,"_21":87},{"_40":41,"_42":43,"_44":-5,"_45":-5,"_46":47,"_48":49,"_50":51,"_52":-5,"_53":-5,"_54":-5,"_55":-5,"_56":-5,"_57":-5,"_58":-5,"_59":60,"_61":-5,"_62":-5,"_63":-5,"_64":-5,"_65":-5,"_66":-5,"_67":-5,"_68":-5,"_69":-5,"_70":-5,"_71":-5,"_72":-5,"_73":-5,"_74":-5,"_75":76,"_21":-5},"_key","faqcta01","_type","ctaBlock","backgroundImage","backgroundImageHotspot","body","Our team typically responds within one business day.","buttonLabel","Get In Touch","buttonLink",{"_77":-5,"_78":79,"_80":78,"_81":-5},"cards","columns","content","ctaLabel","ctaLink","eyebrow","formHeading","heading","STILL HAVE\nQUESTIONS?","height","image","imagePosition","imageSize","infoHeading","items","primaryButtonLabel","primaryButtonLink","secondaryButtonLabel","secondaryButtonLink","stats","subheading","testimonials","text","theme","dark","href","internal",{"_42":7,"_19":82},"kind","newTab","contact","faqwa0001","faqBlock",[88,89],"gray","Warranties & Aftercare",{"_90":94,"_92":95},{"_90":91,"_92":93},"answer","Yes. We offer a 12-month courtesy maintenance period where minor defects and items on your handover list are attended to at no additional cost. Beyond that, we provide ongoing support and can quote for any future maintenance or improvement works.","question","Do you offer ongoing maintenance support after handover?","All works are covered by a statutory 10-year major defects warranty and a 2-year non-major defects warranty under the Building Act 1993 (Victoria). Structural and waterproofing warranties from subcontractors are also passed on to you in full.","What warranties come with a SIARI BUILD project?","faqdc0001",[99,100,101],"During Construction",{"_90":106,"_92":107},{"_90":104,"_92":105},{"_90":102,"_92":103},"Variations are documented formally before any work proceeds. We'll provide a written variation order detailing the cost and any time impact. No variation is actioned until you've approved and signed off.","What happens if I want to make changes mid-build?","Of course — it is your home. We ask that all visits are arranged in advance with your project manager to ensure safety inductions are completed and the site is prepared for a visitor walkthrough.","Can I visit the site during construction?","You'll receive a weekly written site update along with photographs of key milestones. Your project manager is available by phone and email, and we schedule site walks at every major stage — slab, frame, lock-up, and pre-handover.","How will I be kept updated during my build?","faqcc0001",[111,112,113],"Cost & Contracts",{"_90":118,"_92":119},{"_90":116,"_92":117},{"_90":114,"_92":115},"Our HIA-standard contracts include full scope of works, specifications, allowances, progress payment schedule, provisional sums list, and warranty provisions. We walk through every clause with you before signing.","What does the contract include?","For new homes and major renovations, an initial deposit of 5–10% of the contract value is required upon signing. All deposits are held in accordance with the Domestic Building Contracts Act (Victoria).","What deposit is required to secure a build?","Projects are priced on a fixed-price contract basis wherever possible, so you know exactly what you're paying before construction begins. Provisional sums are clearly itemised for selections not yet finalised — there are no hidden surprises.","How are your builds priced?","faqdp0001",[123,124,125],"Design & Planning",{"_90":130,"_92":131},{"_90":128,"_92":129},{"_90":126,"_92":127},"Planning and building permits typically take between 4 and 16 weeks depending on the council, complexity of the application, and whether a planning permit is required. We manage this process on your behalf and keep you informed at every step.","How long does the planning and permit process take?","Absolutely. We regularly collaborate with architects, interior designers, and landscape architects nominated by our clients. We have a collaborative approach and integrate smoothly with your existing design team.","Can you work with my existing architect or designer?","You don't need one before reaching out, but for new builds and major extensions, working with a registered architect is strongly recommended. We have established relationships with several Melbourne architects and can facilitate introductions if needed.","Do I need an architect before approaching you?","faqgs0001",[135,136,137],"Getting Started",{"_90":142,"_92":143},{"_90":140,"_92":141},{"_90":138,"_92":139},"We specialise in custom new homes, whole-home renovations, first and second-storey extensions, kitchen and bathroom remodels, and high-end fitouts. Every project is residential — we do not undertake commercial construction.","What types of projects do you take on?","We service metropolitan Melbourne and surrounding suburbs, with particular focus on inner-east, inner-north, and bayside areas. Contact us to confirm if your project falls within our service zone.","What areas of Melbourne do you service?","The process starts with a no-obligation consultation where we listen to your vision, review your site or existing property, and discuss your budget and timeline. From there we'll prepare a detailed proposal outlining scope, costings, and a projected build schedule.","How do I begin the process of building with SIARI BUILD?","faqhero01","heroInner","https://cdn.sanity.io/images/f0yvhrzy/production/dbc2b4a5f032554b5f5aea0f2de731c02ecc52ce-4000x2500.jpg","Support","FREQUENTLY\nASKED.","compact","Answers to the questions we hear most often — from first consultation through to handover.",{"_152":153,"_154":155},"settings",{"_192":193,"_194":195,"_196":197,"_198":199,"_200":29,"_201":202,"_203":-5,"_204":205,"_206":159,"_207":-5,"_208":-5,"_209":159,"_210":211,"_212":213,"_214":215,"_216":217,"_218":-5,"_219":220,"_221":222,"_223":224,"_225":226,"_227":228},"navigation",{"_156":157,"_158":159,"_160":161,"_162":163},"footerMenu",[183,184,185,186,187,188],"headerCtaEnabled",true,"headerMenu",[170,171,172,173],"socialMenu",[164],{"_165":-5,"_166":167,"_168":169},"icon","label","Instagram","url","https://www.instagram.com/siari_build/",{"_166":-5,"_175":181,"_176":182},{"_166":-5,"_175":179,"_176":180},{"_166":-5,"_175":12,"_176":178},{"_166":174,"_175":82,"_176":177},"Start Your Project","pageSlug","pageTitle","Contact","Projects","about","About","home","Home",{"_166":-5,"_175":181,"_176":182},{"_166":-5,"_175":179,"_176":180},{"_166":-5,"_175":12,"_176":178},{"_166":-5,"_175":82,"_176":177},{"_166":191,"_175":20,"_176":22},{"_166":-5,"_175":189,"_176":190},"privacy-policy","Privacy Policy","FAQ","address","Point Cook, Victoria","copyrightText","All rights reserved.","email","info@siaribuild.com.au","legalLine","ABN 20 688 039 894 | Builder License CDB-U 101713","maintenanceEnabled","maintenanceHeading","WE'RE ON THE TOOLS.","maintenanceImage","maintenanceMessage","The site's getting a quick upgrade and will be back shortly. In the meantime, if you'd like to start a project, reach us using the options below.","maintenanceShowContact","mapAddressLabel","mapAreaRadius","mapHidePin","mapLocation",{"_42":229,"_230":231,"_232":233,"_234":235},"mapZoom",12,"notFoundButtonLabel","Back to Home","notFoundHeading","THIS ONE'S OFF THE PLANS.","notFoundImage","notFoundMessage","The page you're after isn't here — moved, renamed, or never built. Let's get you back to solid ground.","phone","0419 000 991","siteName","Siari Build","tagline","We don't just build houses. We build the next forty years of your life.","workingHours","Monday - Friday: 8:00 AM - 5:00 PM\nSaturday: 9:00 AM - 2:00 PM\nSunday: Closed","geopoint","alt",7,"lat",-37.895696,"lng",144.76186]
